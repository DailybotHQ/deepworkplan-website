// Generated by devcontainer-kit (`dck init`) from .devcontainer/dck.toml.
// dck reconciles: dockerComposeFile, service, runServices, remoteUser, workspaceFolder, shutdownAction.
// Every other key is yours.
{
  "name": "DWP Website - Astro",
  "dockerComposeFile": "../docker/local/docker-compose.yaml",
  "service": "dwpwebsite",
  "shutdownAction": "none",
  "workspaceFolder": "/app",
  "runServices": [
    "dwpwebsite"
  ],
  "remoteUser": "node",
  "customizations": {
    "settings": {
      "terminal.integrated.shell.linux": "/bin/bash"
    },
    "vscode": {
      "extensions": [
        "eamodio.gitlens",
        "VisualStudioExptTeam.vscodeintellicode",
        "vscode-icons-team.vscode-icons",
        "biomejs.biome",
        "unifiedjs.vscode-mdx",
        "astro-build.astro-vscode",
        "bradlc.vscode-tailwindcss",
        "svelte.svelte-vscode"
      ]
    }
  }
}
