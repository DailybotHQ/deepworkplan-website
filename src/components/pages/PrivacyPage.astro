---
import Kicker from '@/components/editorial/Kicker.astro';
import Lead from '@/components/editorial/Lead.astro';
import Rule from '@/components/editorial/Rule.astro';
import JsonLd from '@/components/JsonLd.astro';
import MainLayout from '@/layouts/MainLayout.astro';
import type { Language } from '@/lib/i18n';
import { getUrlPrefix } from '@/lib/i18n';
import { getTranslations } from '@/lib/translations';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
const p = t.privacyPage;
const prefix = getUrlPrefix(lang);
const siteUrl = Astro.site?.href?.replace(/\/$/, '') ?? '';

const privacySchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: p.meta.title,
  description: p.meta.description,
  url: `${siteUrl}${prefix}/privacy`,
  about: { '@type': 'WebPage', name: 'Privacy policy' },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: `${siteUrl}${prefix}/`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: t.nav.privacy,
      item: `${siteUrl}${prefix}/privacy`,
    },
  ],
};
---

<MainLayout lang={lang} title={p.meta.title} description={p.meta.description}>
  <Fragment slot="head">
    <JsonLd data={privacySchema} />
    <JsonLd data={breadcrumbSchema} />
  </Fragment>

  <article class="main-container py-16 md:py-24">
    <header class="max-w-3xl">
      <Kicker>{p.eyebrow}</Kicker>
      <h1
        class="font-display mt-4 text-4xl font-bold tracking-tight sm:text-5xl"
        style="color: var(--color-ink);"
      >
        {p.title}
      </h1>
      <Lead class="mt-6">{p.intro}</Lead>
      <p class="kicker mt-6" style="color: var(--color-muted);">{p.lastUpdated}</p>
    </header>

    <Rule class="my-12" />

    <div class="max-w-3xl space-y-10">
      {
        p.sections.map((section) => (
          <section>
            <h2
              class="font-display text-2xl font-semibold"
              style="color: var(--color-ink);"
            >
              {section.heading}
            </h2>
            <p class="mt-3 leading-relaxed" style="color: var(--color-muted);">
              {section.body}
            </p>
          </section>
        ))
      }
    </div>

    <Rule class="my-12" />

    {/* Contact & security */}
    <section
      class="max-w-3xl border-l-2 pl-6"
      style="border-color: var(--color-secondary);"
    >
      <Kicker>{p.contactTitle}</Kicker>
      <p class="mt-4 text-lg leading-relaxed" style="color: var(--color-ink);">
        {p.contactBody}
      </p>
      <div class="mt-5 flex flex-wrap gap-4">
        <a
          href="mailto:security@dailybot.com"
          class="inline-flex items-center rounded-sm px-6 py-3 font-semibold transition hover:opacity-90"
          style="background-color: var(--color-ink); color: var(--color-paper);"
        >
          security@dailybot.com
        </a>
        <a
          href="/.well-known/security.txt"
          class="inline-flex items-center rounded-sm border px-6 py-3 font-semibold transition hover:opacity-80"
          style="border-color: var(--color-line); color: var(--color-ink);"
        >
          security.txt
        </a>
      </div>
    </section>
  </article>
</MainLayout>
