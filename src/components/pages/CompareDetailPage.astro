---
import Kicker from '@/components/editorial/Kicker.astro';
import Lead from '@/components/editorial/Lead.astro';
import Rule from '@/components/editorial/Rule.astro';
import JsonLd from '@/components/JsonLd.astro';
import CompareMatrix from '@/components/pages/CompareMatrix.astro';
import MainLayout from '@/layouts/MainLayout.astro';
import {
  type AlternativeId,
  COMPARE_REVIEWED_ON,
  getAlternative,
} from '@/lib/compare-data';
import { getUrlPrefix, type Language } from '@/lib/i18n';
import { getTranslations } from '@/lib/translations';

interface Props {
  lang: Language;
  alternativeId: AlternativeId;
}

const { lang, alternativeId } = Astro.props;
const t = getTranslations(lang);
const c = t.comparePage;
const alternative = getAlternative(alternativeId);
const details = c.alternatives[alternative.id];
const prefix = getUrlPrefix(lang);
const siteUrl = Astro.site?.href?.replace(/\/$/, '') ?? '';
const title = `${details.name} × Deep Work Plan`;
const description = `${details.whatItDoesWell} ${details.audience}`;
const reviewedOn = new Date(
  `${COMPARE_REVIEWED_ON}T00:00:00Z`
).toLocaleDateString(lang, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  url: `${siteUrl}${prefix}/compare/${alternative.id}`,
  dateModified: COMPARE_REVIEWED_ON,
};
---

<MainLayout lang={lang} title={title} description={description}>
  <JsonLd slot="head" data={webPageSchema} />
  <article class="main-container py-16 md:py-24">
    <a
      href={`${prefix}/compare`}
      class="inline-flex min-h-[44px] items-center font-semibold underline decoration-1 underline-offset-4"
      style="color: var(--color-secondary);"
    >
      ← {c.profile.backLabel}
    </a>

    <header class="mt-12 max-w-3xl">
      <Kicker>{c.profile.eyebrow}</Kicker>
      <h1 class="font-display mt-4 text-4xl font-bold tracking-tight sm:text-5xl" style="color: var(--color-ink);">
        {title}
      </h1>
      <Lead class="mt-6">{details.whatItDoesWell}</Lead>
      <p class="mt-5 text-lg leading-relaxed" style="color: var(--color-muted);">{details.audience}</p>
      <p class="kicker mt-6">{c.reviewedOnLabel}: <time datetime={COMPARE_REVIEWED_ON}>{reviewedOn}</time></p>
    </header>

    <Rule class="my-12" />

    <section aria-labelledby="compare-fit">
      <Kicker>{c.profile.compareWith}</Kicker>
      <div class="mt-6 grid gap-8 lg:grid-cols-2">
        <div class="border-t pt-4" style="border-color: var(--color-line);">
          <h2 id="compare-fit" class="font-display text-2xl font-semibold" style="color: var(--color-ink);">
            {c.profile.fitTitle}
          </h2>
          <p class="mt-4 text-lg leading-relaxed" style="color: var(--color-ink);">{details.whatItDoesWell}</p>
          <p class="mt-4 leading-relaxed" style="color: var(--color-muted);">{details.audience}</p>
        </div>
        <div class="border-t pt-4" style="border-color: var(--color-line);">
          <h2 class="font-display text-2xl font-semibold" style="color: var(--color-ink);">
            {c.dwpStrengths.title}
          </h2>
          <ul class="mt-4 space-y-4">
            {c.dwpStrengths.items.slice(0, 3).map((item) => (
              <li>
                <h3 class="font-semibold" style="color: var(--color-ink);">{item.title}</h3>
                <p class="mt-1 leading-relaxed" style="color: var(--color-muted);">{item.body}</p>
              </li>
            ))}
          </ul>
        </div>
      </div>
      <div class="mt-8 border-l-2 pl-5" style="border-color: var(--color-secondary);">
        <p class="font-semibold" style="color: var(--color-ink);">{c.profile.fitTitle}: {c.alternatives.dwp.audience}</p>
      </div>
      <aside class="mt-8 border-t pt-4" style="border-color: var(--color-line);">
        <p class="kicker">{c.profile.sourceLabel}</p>
        <a href={alternative.docsUrl} target="_blank" rel="noopener noreferrer" class="mt-3 block break-words font-semibold underline decoration-1 underline-offset-4" style="color: var(--color-ink);">
          {alternative.docsUrl}
        </a>
      </aside>
    </section>

    <Rule class="my-12" />

    <section aria-labelledby="compare-capabilities">
      <h2 id="compare-capabilities" class="font-display text-2xl font-semibold" style="color: var(--color-ink);">
        {c.profile.capabilityTitle}
      </h2>
      <div class="mt-6 max-w-5xl">
        <CompareMatrix lang={lang} alternativeIds={['dwp', alternative.id]} />
      </div>
    </section>

    <Rule class="my-12" />

    <p>
      <a href={alternative.homepage} target="_blank" rel="noopener noreferrer" class="font-semibold underline decoration-1 underline-offset-4" style="color: var(--color-secondary);">
        {c.officialSiteLabel} →
      </a>
    </p>
  </article>
</MainLayout>
