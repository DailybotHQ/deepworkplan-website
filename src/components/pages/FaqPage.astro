---
import Kicker from '@/components/editorial/Kicker.astro';
import Lead from '@/components/editorial/Lead.astro';
import Rule from '@/components/editorial/Rule.astro';
import JsonLd from '@/components/JsonLd.astro';
import MainLayout from '@/layouts/MainLayout.astro';
import { REPO_URLS } from '@/lib/constants/repos';
import { getUrlPrefix, type Language } from '@/lib/i18n';
import { getTranslations } from '@/lib/translations';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
const f = t.faqPage;
const prefix = getUrlPrefix(lang);
const siteUrl = Astro.site?.href?.replace(/\/$/, '') ?? '';
const discussionsUrl = `${REPO_URLS.website}/discussions`;

function faqItemHref(linkPath: string): string {
  if (linkPath.startsWith('http://') || linkPath.startsWith('https://')) {
    return linkPath;
  }
  return `${prefix}${linkPath}`;
}

function isExternalFaqLink(linkPath: string): boolean {
  return linkPath.startsWith('http://') || linkPath.startsWith('https://');
}

function sectionKicker(index: number): string {
  return String(index + 1).padStart(2, '0');
}

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  name: f.meta.title,
  description: f.meta.description,
  url: `${siteUrl}${prefix}/faq`,
  mainEntity: f.groups.flatMap((group) =>
    group.items.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    }))
  ),
};
---

<MainLayout lang={lang} title={f.meta.title} description={f.meta.description}>
  <JsonLd slot="head" data={faqSchema} />

  <article class="main-container py-16 md:py-24">
    <header class="max-w-3xl">
      <Kicker>{f.eyebrow}</Kicker>
      <h1
        class="font-display mt-4 text-4xl font-bold tracking-tight sm:text-5xl"
        style="color: var(--color-ink);"
      >
        {f.title}
      </h1>
      <Lead class="mt-6">{f.intro}</Lead>
    </header>

    <nav class="mt-12 max-w-3xl" aria-label={f.tocTitle}>
      <Kicker>{f.tocTitle}</Kicker>
      <ul class="mt-4 flex flex-wrap gap-x-6 gap-y-3">
        {
          f.groups.map((group) => (
            <li>
              <a
                href={`#faq-group-${group.id}`}
                class="text-sm font-semibold underline decoration-1 underline-offset-4 transition hover:opacity-80"
                style="color: var(--color-secondary);"
              >
                {group.title}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <Rule class="my-12" />

    <div class="max-w-3xl space-y-20 md:space-y-24">
      {
        f.groups.map((group, groupIndex) => (
          <section aria-labelledby={`faq-group-${group.id}`}>
            <Kicker>{sectionKicker(groupIndex)}</Kicker>
            <h2
              id={`faq-group-${group.id}`}
              class="font-display mt-3 scroll-mt-28 text-2xl font-semibold"
              style="color: var(--color-ink);"
            >
              {group.title}
            </h2>
            <div class="mt-6 border-t" style="border-color: var(--color-line);">
              {group.items.map((item, itemIndex) => (
                <details
                  id={`faq-${item.id}`}
                  class="faq-item scroll-mt-28 border-b"
                  style="border-color: var(--color-line);"
                  open={groupIndex === 0 && itemIndex === 0}
                >
                  <summary class="faq-summary flex cursor-pointer items-start justify-between gap-4 py-4">
                    <span
                      class="font-display text-lg font-semibold leading-snug"
                      style="color: var(--color-ink);"
                    >
                      {item.question}
                    </span>
                    <svg
                      class="faq-chevron mt-1 h-5 w-5 shrink-0"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                    </svg>
                  </summary>
                  <div class="pb-6">
                    <p class="text-lg leading-relaxed" style="color: var(--color-muted);">
                      {item.answer}
                    </p>
                    {item.linkPath && item.linkLabel && (
                      <p class="mt-3">
                        <a
                          href={faqItemHref(item.linkPath)}
                          class="font-semibold underline decoration-1 underline-offset-4 transition hover:opacity-80"
                          style="color: var(--color-secondary);"
                          target={isExternalFaqLink(item.linkPath) ? '_blank' : undefined}
                          rel={isExternalFaqLink(item.linkPath) ? 'noopener noreferrer' : undefined}
                        >
                          {item.linkLabel}
                        </a>
                      </p>
                    )}
                  </div>
                </details>
              ))}
            </div>
          </section>
        ))
      }
    </div>

    <Rule class="my-12" />

    <section class="max-w-3xl">
      <Kicker>{f.stillHaveQuestions.title}</Kicker>
      <p class="mt-4 text-lg leading-relaxed" style="color: var(--color-muted);">
        {f.stillHaveQuestions.body}
      </p>
      <div class="mt-6 flex flex-wrap gap-4">
        <a
          href={discussionsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center rounded-sm border px-5 py-3 font-semibold transition hover:opacity-80"
          style="border-color: var(--color-line); color: var(--color-ink);"
        >
          {f.stillHaveQuestions.ctaLabel}
        </a>
        <a
          href={`${prefix}/contact`}
          class="inline-flex items-center rounded-sm border px-5 py-3 font-semibold transition hover:opacity-80"
          style="border-color: var(--color-line); color: var(--color-ink);"
        >
          {t.nav.contact}
        </a>
      </div>
    </section>
  </article>
</MainLayout>

<style>
  .faq-summary {
    list-style: none;
  }
  .faq-summary::-webkit-details-marker {
    display: none;
  }
  .faq-summary:focus-visible {
    outline: 2px solid var(--color-secondary);
    outline-offset: 4px;
  }
  .faq-chevron {
    color: var(--color-secondary);
    transition: transform 200ms ease;
  }
  .faq-item[open] .faq-chevron {
    transform: rotate(180deg);
  }
  @media (prefers-reduced-motion: reduce) {
    .faq-chevron {
      transition: none;
    }
  }
</style>
