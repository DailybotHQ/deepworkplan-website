---
import Kicker from '@/components/editorial/Kicker.astro';
import Lead from '@/components/editorial/Lead.astro';
import Rule from '@/components/editorial/Rule.astro';
import JsonLd from '@/components/JsonLd.astro';
import MainLayout from '@/layouts/MainLayout.astro';
import type { Language } from '@/lib/i18n';
import { CANONICAL_INIT_MD_PATH, getUrlPrefix } from '@/lib/i18n';
import { getTranslations } from '@/lib/translations';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
const p = t.developersPage;
const prefix = getUrlPrefix(lang);
const siteUrl = Astro.site?.href?.replace(/\/$/, '') ?? '';

// Code samples are code — never localized (mirrors TrustPage's verify recipe).
const mcpExample = `# 1. Initialize (no session needed — the server is stateless)
curl -s https://deepworkplan.com/api/mcp \\
  -H 'Content-Type: application/json' \\
  -d '{"jsonrpc":"2.0","id":1,"method":"initialize",
       "params":{"protocolVersion":"2025-06-18","capabilities":{},
                 "clientInfo":{"name":"curl","version":"1.0"}}}'

# 2. Discover the tools
curl -s https://deepworkplan.com/api/mcp \\
  -H 'Content-Type: application/json' \\
  -d '{"jsonrpc":"2.0","id":2,"method":"tools/list"}'

# 3. Call one — read any page as source Markdown
curl -s https://deepworkplan.com/api/mcp \\
  -H 'Content-Type: application/json' \\
  -d '{"jsonrpc":"2.0","id":3,"method":"tools/call",
       "params":{"name":"read_page","arguments":{"path":"/init"}}}'`;

const markdownExample = `# Ask for Markdown on any URL (content negotiation)
curl -s https://deepworkplan.com/methodology \\
  -H 'Accept: text/markdown'

# Or fetch the .md mirror directly — every page has one, in every language
curl -s https://deepworkplan.com/es/developers.md`;

const cliExample = `# 1. Install the DWP skill — same command the /init endpoint gives agents
npx skills add DailybotHQ/deepworkplan-skill@latest

# 2. Official CLI — zero-dependency client over this API (Node >= 18),
#    prepared in the site repo's cli/ directory pending npm publication
deepworkplan init
deepworkplan read /es/developers`;

// Two worked combinations of format (Lite/Full) x review mode (trust/guided).
// Commands and flags are literal — never localized.
const quickFixExample = `# A small, bounded fix: skip the review round, run it directly.
/dwp-create fix the flaky checkout test trust
/dwp-execute`;

const longHorizonExample = `# Long-horizon work with real stakes: review before anything runs.
/dwp-create migrate the billing service to the new payments API
# ...review the proposed plan, then:
/dwp-execute
# ...interrupted? pick up again, even in a fresh session:
/dwp-resume`;

const developersSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: p.meta.title,
  description: p.meta.description,
  url: `${siteUrl}${prefix}/developers`,
  about: {
    '@type': 'SoftwareApplication',
    name: 'Deep Work Plan',
    applicationCategory: 'DeveloperApplication',
    license: 'https://opensource.org/licenses/MIT',
    author: {
      '@type': 'Organization',
      name: 'Dailybot',
      url: 'https://www.dailybot.com',
    },
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: `${siteUrl}${prefix}/`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: t.nav.developers,
      item: `${siteUrl}${prefix}/developers`,
    },
  ],
};
---

<MainLayout lang={lang} title={p.meta.title} description={p.meta.description}>
  <Fragment slot="head">
    <JsonLd data={developersSchema} />
    <JsonLd data={breadcrumbSchema} />
  </Fragment>

  <article class="main-container py-16 md:py-24">
    <header class="max-w-3xl">
      <Kicker>{p.eyebrow}</Kicker>
      <h1
        class="font-display mt-4 text-4xl font-bold tracking-tight sm:text-5xl"
        style="color: var(--color-ink);"
      >
        {p.title}
      </h1>
      <Lead class="mt-6">{p.intro}</Lead>
    </header>

    <Rule class="my-12" />

    {/* Zero-auth by design */}
    <section>
      <Kicker>{p.accessTitle}</Kicker>
      <p class="mt-4 max-w-3xl text-lg leading-relaxed" style="color: var(--color-ink);">
        {p.accessIntro}
      </p>
      <div class="mt-6 grid gap-6 md:grid-cols-2">
        {
          p.accessPoints.map((point) => (
            <div class="flex flex-col border p-6" style="border-color: var(--color-line);">
              <h2
                class="font-display text-xl font-semibold"
                style="color: var(--color-ink);"
              >
                {point.title}
              </h2>
              <p class="mt-3 leading-relaxed" style="color: var(--color-muted);">
                {point.body}
              </p>
            </div>
          ))
        }
      </div>
    </section>

    <Rule class="my-12" />

    {/* Plan and execute with the skill */}
    <section class="max-w-4xl">
      <Kicker>{p.planTitle}</Kicker>
      <p class="mt-4 text-lg leading-relaxed" style="color: var(--color-ink);">
        {p.planIntro}
      </p>

      <h3
        class="font-display mt-10 text-xl font-semibold"
        style="color: var(--color-ink);"
      >
        {p.formatTitle}
      </h3>
      <p class="mt-3 leading-relaxed" style="color: var(--color-muted);">
        {p.formatIntro}
      </p>
      <div class="mt-6 grid gap-6 sm:grid-cols-2">
        {
          p.formatAxes.map((axis) => (
            <div class="flex flex-col border p-6" style="border-color: var(--color-line);">
              <h4
                class="font-display text-lg font-semibold"
                style="color: var(--color-ink);"
              >
                {axis.title}
              </h4>
              <p class="mt-3 leading-relaxed" style="color: var(--color-muted);">
                {axis.body}
              </p>
            </div>
          ))
        }
      </div>

      <h3
        class="font-display mt-10 text-xl font-semibold"
        style="color: var(--color-ink);"
      >
        {p.commandsTitle}
      </h3>
      <p class="mt-3 leading-relaxed" style="color: var(--color-muted);">
        {p.commandsIntro}
      </p>
      <div class="mt-6 overflow-x-auto">
        <table class="w-full border-collapse text-left" style="border-color: var(--color-line);">
          <caption class="sr-only">{p.commandsTitle}</caption>
          <tbody>
            {
              p.commands.map((cmd) => (
                <tr style="border-bottom: 1px solid var(--color-line);">
                  <td class="py-3 pr-4 align-top">
                    <a href={cmd.href}>
                      <code
                        class="font-mono text-xs font-semibold underline underline-offset-4"
                        style="color: var(--color-secondary);"
                      >
                        {cmd.name}
                      </code>
                    </a>
                  </td>
                  <td class="py-3 align-top text-sm leading-relaxed" style="color: var(--color-muted);">
                    {cmd.description}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <h3
        class="font-display mt-10 text-xl font-semibold"
        style="color: var(--color-ink);"
      >
        {p.examplesTitle}
      </h3>
      <p class="mt-3 leading-relaxed" style="color: var(--color-muted);">
        {p.examplesIntro}
      </p>
      <div class="mt-6 grid gap-6 lg:grid-cols-2">
        <div>
          <h4
            class="font-display text-base font-semibold"
            style="color: var(--color-ink);"
          >
            {p.quickFixLabel}
          </h4>
          <p class="mt-2 text-sm leading-relaxed" style="color: var(--color-muted);">
            {p.quickFixBody}
          </p>
          <div class="mt-4 overflow-hidden border" style="border-color: var(--color-line);">
            <div
              class="border-b px-3 py-1.5"
              style="border-color: var(--color-line); background-color: var(--color-gray-100);"
            >
              <span class="kicker">{p.planCodeLabel}</span>
            </div>
            <pre class="overflow-x-auto px-3 py-3" style="background-color: var(--color-gray-100);"><code class="font-mono text-xs leading-relaxed" style="color: var(--color-ink);">{quickFixExample}</code></pre>
          </div>
        </div>
        <div>
          <h4
            class="font-display text-base font-semibold"
            style="color: var(--color-ink);"
          >
            {p.longHorizonLabel}
          </h4>
          <p class="mt-2 text-sm leading-relaxed" style="color: var(--color-muted);">
            {p.longHorizonBody}
          </p>
          <div class="mt-4 overflow-hidden border" style="border-color: var(--color-line);">
            <div
              class="border-b px-3 py-1.5"
              style="border-color: var(--color-line); background-color: var(--color-gray-100);"
            >
              <span class="kicker">{p.planCodeLabel}</span>
            </div>
            <pre class="overflow-x-auto px-3 py-3" style="background-color: var(--color-gray-100);"><code class="font-mono text-xs leading-relaxed" style="color: var(--color-ink);">{longHorizonExample}</code></pre>
          </div>
        </div>
      </div>
      <p class="mt-6 leading-relaxed" style="color: var(--color-muted);">
        {p.planNote}
      </p>
    </section>

    <Rule class="my-12" />

    {/* Endpoints */}
    <section class="max-w-4xl">
      <Kicker>{p.endpointsTitle}</Kicker>
      <p class="mt-4 text-lg leading-relaxed" style="color: var(--color-ink);">
        {p.endpointsIntro}
      </p>
      <div class="mt-6 overflow-x-auto">
        <table class="w-full border-collapse text-left" style="border-color: var(--color-line);">
          <caption class="sr-only">{p.endpointsTitle}</caption>
          <tbody>
            {
              p.endpoints.map((endpoint) => (
                <tr style="border-bottom: 1px solid var(--color-line);">
                  <td class="py-3 pr-4 align-top">
                    <code
                      class="font-mono text-xs font-semibold"
                      style="color: var(--color-secondary);"
                    >
                      {endpoint.method}
                    </code>
                  </td>
                  <td class="py-3 pr-4 align-top">
                    <code class="font-mono text-xs" style="color: var(--color-ink);">
                      {endpoint.path}
                    </code>
                  </td>
                  <td class="py-3 align-top text-sm leading-relaxed" style="color: var(--color-muted);">
                    {endpoint.description}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="mt-4 leading-relaxed" style="color: var(--color-muted);">
        {p.endpointsNote}
      </p>
    </section>

    <Rule class="my-12" />

    {/* Versioning & deprecation */}
    <section class="max-w-3xl">
      <Kicker>{p.versioningTitle}</Kicker>
      <p class="mt-4 text-lg leading-relaxed" style="color: var(--color-ink);">
        {p.versioningBody}
      </p>
    </section>

    <Rule class="my-12" />

    {/* Rate limits */}
    <section class="max-w-3xl">
      <Kicker>{p.rateLimitsTitle}</Kicker>
      <p class="mt-4 text-lg leading-relaxed" style="color: var(--color-ink);">
        {p.rateLimitsBody}
      </p>
    </section>

    <Rule class="my-12" />

    {/* MCP server */}
    <section class="max-w-3xl">
      <Kicker>{p.mcpTitle}</Kicker>
      <p class="mt-4 text-lg leading-relaxed" style="color: var(--color-ink);">
        {p.mcpIntro}
      </p>
      <div class="mt-5 overflow-hidden border" style="border-color: var(--color-line);">
        <div
          class="border-b px-3 py-1.5"
          style="border-color: var(--color-line); background-color: var(--color-gray-100);"
        >
          <span class="kicker">{p.mcpCodeLabel}</span>
        </div>
        <pre class="overflow-x-auto px-3 py-3" style="background-color: var(--color-gray-100);"><code class="font-mono text-xs leading-relaxed" style="color: var(--color-ink);">{mcpExample}</code></pre>
      </div>
      <p class="mt-4 leading-relaxed" style="color: var(--color-muted);">
        {p.mcpNote}
      </p>
    </section>

    <Rule class="my-12" />

    {/* Markdown for agents */}
    <section class="max-w-3xl">
      <Kicker>{p.markdownTitle}</Kicker>
      <p class="mt-4 text-lg leading-relaxed" style="color: var(--color-ink);">
        {p.markdownIntro}
      </p>
      <div class="mt-5 overflow-hidden border" style="border-color: var(--color-line);">
        <div
          class="border-b px-3 py-1.5"
          style="border-color: var(--color-line); background-color: var(--color-gray-100);"
        >
          <span class="kicker">{p.markdownCodeLabel}</span>
        </div>
        <pre class="overflow-x-auto px-3 py-3" style="background-color: var(--color-gray-100);"><code class="font-mono text-xs leading-relaxed" style="color: var(--color-ink);">{markdownExample}</code></pre>
      </div>
      <p class="mt-4 leading-relaxed" style="color: var(--color-muted);">
        {p.markdownNote}
      </p>
    </section>

    <Rule class="my-12" />

    {/* Install the kit */}
    <section class="max-w-3xl">
      <Kicker>{p.cliTitle}</Kicker>
      <p class="mt-4 text-lg leading-relaxed" style="color: var(--color-ink);">
        {p.cliIntro}
      </p>
      <div class="mt-5 overflow-hidden border" style="border-color: var(--color-line);">
        <div
          class="border-b px-3 py-1.5"
          style="border-color: var(--color-line); background-color: var(--color-gray-100);"
        >
          <span class="kicker">{p.cliCodeLabel}</span>
        </div>
        <pre class="overflow-x-auto px-3 py-3" style="background-color: var(--color-gray-100);"><code class="font-mono text-xs leading-relaxed" style="color: var(--color-ink);">{cliExample}</code></pre>
      </div>
      <p class="mt-4 leading-relaxed" style="color: var(--color-muted);">
        {p.cliNote}
      </p>
    </section>

    <Rule class="my-12" />

    {/* Machine-readable resources */}
    <section class="max-w-3xl">
      <Kicker>{p.resourcesTitle}</Kicker>
      <ul class="mt-6 space-y-3">
        {
          p.resources.map((res) => (
            <li class="flex items-start gap-3">
              <span class="mt-1 shrink-0" style="color: var(--color-secondary);" aria-hidden="true">
                &#9656;
              </span>
              <a
                href={res.href}
                class="underline underline-offset-4 hover:opacity-80"
                style="color: var(--color-ink);"
              >
                {res.label}
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <Rule class="my-12" />

    {/* CTA */}
    <section class="max-w-3xl">
      <h2
        class="font-display text-2xl font-bold md:text-3xl"
        style="color: var(--color-ink);"
      >
        {p.ctaTitle}
      </h2>
      <p class="mt-4 text-lg leading-relaxed" style="color: var(--color-muted);">
        {p.ctaBody}
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a
          href={CANONICAL_INIT_MD_PATH}
          class="inline-flex items-center rounded-sm px-6 py-3 font-semibold transition hover:opacity-90"
          style="background-color: var(--color-ink); color: var(--color-paper);"
        >
          {p.ctaPrimary}
        </a>
        <a
          href={`${prefix}/methodology`}
          class="inline-flex items-center rounded-sm border px-6 py-3 font-semibold transition hover:opacity-80"
          style="border-color: var(--color-line); color: var(--color-ink);"
        >
          {p.ctaSecondary}
        </a>
      </div>
    </section>
  </article>
</MainLayout>
