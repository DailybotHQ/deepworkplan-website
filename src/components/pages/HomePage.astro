---
import ActContextEconomy from '@/components/home/ActContextEconomy.astro';
import ActDoneIsAContract from '@/components/home/ActDoneIsAContract.astro';
import ActHumansSteer from '@/components/home/ActHumansSteer.astro';
import ActPlanNoDrift from '@/components/home/ActPlanNoDrift.astro';
import ActRepoAsHarness from '@/components/home/ActRepoAsHarness.astro';
import Agents from '@/components/home/Agents.astro';
import Archetypes from '@/components/home/Archetypes.astro';
import Comparison from '@/components/home/Comparison.astro';
import FinalCta from '@/components/home/FinalCta.astro';
import Hero from '@/components/home/Hero.astro';
import Onboarding from '@/components/home/Onboarding.astro';
import Origin from '@/components/home/Origin.astro';
import Outcomes from '@/components/home/Outcomes.astro';
import Pitch from '@/components/home/Pitch.astro';
import Quickstart from '@/components/home/Quickstart.astro';
import Stacks from '@/components/home/Stacks.astro';
import MainLayout from '@/layouts/MainLayout.astro';
import { type Language } from '@/lib/i18n';
import { getTranslations } from '@/lib/translations';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
const m = t.home.meta;
---

<MainLayout lang={lang} title={m.title} description={m.description}>
  <Hero lang={lang} />
  <Pitch lang={lang} />
  <ActHumansSteer lang={lang} />
  <ActPlanNoDrift lang={lang} />
  <ActDoneIsAContract lang={lang} />
  <ActRepoAsHarness lang={lang} />
  <ActContextEconomy lang={lang} />
  <Onboarding lang={lang} />
  <Quickstart lang={lang} />
  <Outcomes lang={lang} />
  <Agents lang={lang} />
  <Stacks lang={lang} />
  <Archetypes lang={lang} />
  <Comparison lang={lang} />
  <Origin lang={lang} />
  <FinalCta lang={lang} />
</MainLayout>
