---
import Kicker from '@/components/editorial/Kicker.astro';
import Lead from '@/components/editorial/Lead.astro';
import Rule from '@/components/editorial/Rule.astro';
import JsonLd from '@/components/JsonLd.astro';
import MainLayout from '@/layouts/MainLayout.astro';
import { getUrlPrefix, type Language } from '@/lib/i18n';
import { getTranslations } from '@/lib/translations';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
const v = t.vimPage;
const prefix = getUrlPrefix(lang);
const siteUrl = Astro.site?.href?.replace(/\/$/, '') ?? '';

const repoUrl = 'https://github.com/DailybotHQ/deepworkplan-vim';
const repoWindowsUrl =
  'https://github.com/DailybotHQ/deepworkplan-vim#install-host';
const kitUrl = `${prefix}/kit/vim`;

const features = [
  {
    title: v.featureF1Title,
    description: v.featureF1Description,
    mapping: v.featureF1Mapping,
  },
  {
    title: v.featureF2Title,
    description: v.featureF2Description,
    mapping: v.featureF2Mapping,
  },
  {
    title: v.featureF3Title,
    description: v.featureF3Description,
    mapping: v.featureF3Mapping,
  },
  {
    title: v.featureF4Title,
    description: v.featureF4Description,
    mapping: v.featureF4Mapping,
  },
  {
    title: v.featureF5Title,
    description: v.featureF5Description,
    mapping: v.featureF5Mapping,
  },
];

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: v.heroTitle,
  description: v.meta.description,
  url: `${siteUrl}${prefix}/vim`,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'macOS, Linux',
  license: 'https://www.gnu.org/licenses/gpl-3.0.html',
};
---

<MainLayout lang={lang} title={v.meta.title} description={v.meta.description}>
  <JsonLd slot="head" data={softwareSchema} />

  {/* Dark editorial band — kicker, title, tagline, one-paragraph description */}
  <section class="relative overflow-hidden bg-main text-white">
    <div class="absolute inset-0 opacity-10" aria-hidden="true">
      <svg class="h-full w-full" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="vim-hero-grid" width="40" height="40" patternUnits="userSpaceOnUse">
            <path d="M 40 0 L 0 0 0 40" fill="none" stroke="currentColor" stroke-width="0.5" />
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#vim-hero-grid)"></rect>
      </svg>
    </div>
    <div class="main-container relative py-20 md:py-28">
      <div class="max-w-3xl">
        <span class="kicker text-gray-300">{v.heroKicker}</span>
        <h1
          class="font-display mt-4 text-4xl font-bold tracking-tight sm:text-5xl"
          style="color: #ffffff;"
        >
          {v.heroTitle}
        </h1>
        <p
          class="font-display mt-4 text-xl italic sm:text-2xl"
          style="color: var(--color-gray-100);"
        >
          {v.heroTagline}
        </p>
        <p class="mt-6 text-base leading-relaxed text-gray-300 sm:text-lg">
          {v.heroDescription}
        </p>
      </div>
    </div>
  </section>

  <article class="main-container py-16 md:py-24">
    {/* Install — the canonical one-liner, consent promise, kit doc, Windows note */}
    <section id="install" class="max-w-3xl scroll-mt-24">
      {/* Section heading — kicker markup inlined as a real h2 (Kicker's `as`
          prop doesn't type-check at call sites; markup mirrors the primitive) */}
      <h2 class="kicker flex items-center gap-3">
        <span>{v.installTitle}</span>
        <span class="h-px w-8 shrink-0 bg-secondary" aria-hidden="true"></span>
      </h2>
      <p class="mt-4 text-lg leading-relaxed" style="color: var(--color-muted);">
        {v.installIntro}
      </p>
      <div
        class="mt-6 overflow-hidden border"
        style="border-color: var(--color-line);"
      >
        <div
          class="flex items-center justify-between gap-3 border-b px-3 py-1.5"
          style="border-color: var(--color-line); background-color: var(--color-gray-100);"
        >
          <span class="kicker">bash</span>
          <button
            type="button"
            class="copy-btn kicker inline-flex cursor-pointer items-center gap-1.5 rounded-sm px-2 py-1 transition enabled:hover:opacity-80 disabled:cursor-default disabled:opacity-70"
            style="color: var(--color-secondary);"
            data-copy={v.installCommand}
            data-label={v.installCopyLabel}
            data-copied={v.installCopiedLabel}
            aria-label={v.installCopyLabel}
          >
            {v.installCopyLabel}
          </button>
        </div>
        <pre class="overflow-x-auto px-3 py-3" style="background-color: var(--color-gray-100);"><code class="font-mono text-xs leading-relaxed" style="color: var(--color-ink);">{v.installCommand}</code></pre>
      </div>
      <p
        class="mt-6 border-l-2 pl-4 text-base leading-relaxed"
        style="border-color: var(--color-secondary); color: var(--color-muted);"
      >
        {v.installConsent}
      </p>
      <p class="mt-6">
        <a
          href={kitUrl}
          class="font-semibold underline underline-offset-4 transition hover:opacity-80"
          style="color: var(--color-secondary);"
        >
          {v.installKitLink} →
        </a>
      </p>
      <p class="mt-4 text-base leading-relaxed" style="color: var(--color-muted);">
        {v.installWindowsNote}
        <a
          href={repoWindowsUrl}
          class="underline underline-offset-4 transition hover:opacity-80"
          style="color: var(--color-secondary);">{v.installWindowsLinkLabel}</a
        >
      </p>
    </section>

    <Rule class="my-12" />

    {/* Features — the contract's F1-F5 as a ruled editorial table */}
    <section class="max-w-4xl">
      <h2 class="kicker flex items-center gap-3">
        <span>{v.featuresTitle}</span>
        <span class="h-px w-8 shrink-0 bg-secondary" aria-hidden="true"></span>
      </h2>
      <p class="mt-4 text-lg leading-relaxed" style="color: var(--color-muted);">
        {v.featuresIntro}
      </p>
      <div class="mt-8 overflow-x-auto">
        <table class="w-full border-collapse text-left">
          <thead>
            <tr>
              <th
                scope="col"
                class="kicker border-b px-3 pb-3 pr-4"
                style="border-color: var(--color-ink);"
              >
                {v.tableFeature}
              </th>
              <th
                scope="col"
                class="kicker border-b px-3 pb-3 pr-4"
                style="border-color: var(--color-ink);"
              >
                {v.tableDescription}
              </th>
              <th
                scope="col"
                class="kicker border-b px-3 pb-3"
                style="border-color: var(--color-ink);"
              >
                {v.tableMapping}
              </th>
            </tr>
          </thead>
          <tbody>
            {
              features.map((feature) => (
                <tr class="border-b align-top" style="border-color: var(--color-line);">
                  <th
                    scope="row"
                    class="font-display px-3 py-4 pr-4 text-base font-semibold"
                    style="color: var(--color-ink);"
                  >
                    {feature.title}
                  </th>
                  <td class="px-3 py-4 pr-4 text-base leading-relaxed" style="color: var(--color-muted);">
                    {feature.description}
                  </td>
                  <td class="px-3 py-4">
                    <code
                      class="inline-block whitespace-nowrap rounded-sm px-2 py-0.5 font-mono text-xs"
                      style="background-color: var(--color-gray-100); color: var(--color-ink);"
                    >
                      {feature.mapping}
                    </code>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <Rule class="my-12" />

    {/* Requirements strip */}
    <section class="max-w-3xl">
      <h2 class="kicker flex items-center gap-3">
        <span>{v.requirementsTitle}</span>
        <span class="h-px w-8 shrink-0 bg-secondary" aria-hidden="true"></span>
      </h2>
      <ul class="mt-6 space-y-3">
        {
          v.requirements.map((requirement) => (
            <li class="flex gap-3 text-base leading-relaxed" style="color: var(--color-muted);">
              <span aria-hidden="true" style="color: var(--color-secondary);">
                —
              </span>
              <span>{requirement}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <Rule class="my-12" />

    {/* Closing call-to-action */}
    <section class="max-w-3xl">
      <h2 class="kicker flex items-center gap-3">
        <span>{v.ctaTitle}</span>
        <span class="h-px w-8 shrink-0 bg-secondary" aria-hidden="true"></span>
      </h2>
      <Lead class="mt-4">{v.ctaDescription}</Lead>
      <div class="mt-8 flex flex-wrap gap-4">
        <a
          href="#install"
          class="inline-flex items-center rounded-sm border px-5 py-3 font-semibold transition hover:opacity-80"
          style="border-color: var(--color-line); color: var(--color-ink);"
        >
          {v.ctaPrimaryLabel}
        </a>
        <a
          href={kitUrl}
          class="inline-flex items-center rounded-sm border px-5 py-3 font-semibold transition hover:opacity-80"
          style="border-color: var(--color-line); color: var(--color-ink);"
        >
          {v.ctaKitLabel}
        </a>
        <a
          href={repoUrl}
          class="inline-flex items-center rounded-sm border px-5 py-3 font-semibold transition hover:opacity-80"
          style="border-color: var(--color-line); color: var(--color-ink);"
        >
          {v.ctaRepoLabel}
        </a>
      </div>
    </section>
  </article>
</MainLayout>

<script>
  // Progressive enhancement: copy the install one-liner to the clipboard.
  const COPY_FEEDBACK_MS = 2000;

  document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((btn) => {
    let busy = false;

    btn.addEventListener('click', async () => {
      if (busy || btn.disabled) return;

      const text = btn.dataset.copy ?? '';
      const label = btn.dataset.label ?? '';
      const copied = btn.dataset.copied ?? '';

      busy = true;
      try {
        await navigator.clipboard.writeText(text);
        btn.disabled = true;
        btn.textContent = copied;
        btn.setAttribute('aria-label', copied);
        window.setTimeout(() => {
          btn.disabled = false;
          btn.textContent = label;
          btn.setAttribute('aria-label', label);
          busy = false;
        }, COPY_FEEDBACK_MS);
      } catch {
        busy = false;
      }
    });
  });
</script>
