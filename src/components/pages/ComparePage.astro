---
import Kicker from '@/components/editorial/Kicker.astro';
import Lead from '@/components/editorial/Lead.astro';
import Rule from '@/components/editorial/Rule.astro';
import JsonLd from '@/components/JsonLd.astro';
import MainLayout from '@/layouts/MainLayout.astro';
import {
  ALTERNATIVES,
  type AlternativeCategory,
  COMPARE_REVIEWED_ON,
} from '@/lib/compare-data';
import { REPO_URLS } from '@/lib/constants/repos';
import { getUrlPrefix, type Language } from '@/lib/i18n';
import { getTranslations } from '@/lib/translations';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
const c = t.comparePage;
const prefix = getUrlPrefix(lang);
const siteUrl = Astro.site?.href?.replace(/\/$/, '') ?? '';
const issuesUrl = `${REPO_URLS.website}/issues`;

const reviewedOn = new Date(
  `${COMPARE_REVIEWED_ON}T00:00:00Z`
).toLocaleDateString(lang, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});

const CATEGORY_ORDER: AlternativeCategory[] = [
  'sdd',
  'agent-framework',
  'ai-native-sdlc',
  'vendor-native',
];
const categoryLabel: Record<AlternativeCategory, string> = {
  methodology: c.categories.methodology,
  sdd: c.categories.sdd,
  'agent-framework': c.categories.agentFramework,
  'ai-native-sdlc': c.categories.aiNativeSdlc,
  'vendor-native': c.categories.vendorNative,
};
const others = ALTERNATIVES.filter((alt) => alt.id !== 'dwp');
const grouped = CATEGORY_ORDER.map((category) => ({
  category,
  items: others.filter((alt) => alt.category === category),
})).filter((group) => group.items.length > 0);

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: c.meta.title,
  description: c.meta.description,
  url: `${siteUrl}${prefix}/compare`,
  dateModified: COMPARE_REVIEWED_ON,
  about: ALTERNATIVES.map((alt) => ({
    '@type': 'SoftwareApplication',
    name: c.alternatives[alt.id].name,
    url: alt.homepage,
  })),
};
---

<MainLayout lang={lang} title={c.meta.title} description={c.meta.description}>
  <JsonLd slot="head" data={webPageSchema} />

  <article class="main-container py-16 md:py-24">
    <header class="max-w-3xl">
      <Kicker>{c.eyebrow}</Kicker>
      <h1
        class="font-display mt-4 text-4xl font-bold tracking-tight sm:text-5xl"
        style="color: var(--color-ink);"
      >
        {c.title}
      </h1>
      <Lead class="mt-6">{c.intro}</Lead>
    </header>

    <Rule class="my-12" />

    <section class="max-w-3xl" aria-labelledby="compare-how-to-read">
      <h2 id="compare-how-to-read" class="font-display text-2xl font-semibold" style="color: var(--color-ink);">
        {c.howToRead.title}
      </h2>
      <p class="mt-3 text-lg leading-relaxed" style="color: var(--color-muted);">
        {c.howToRead.body}
      </p>
      <ul class="mt-5 grid gap-3 sm:grid-cols-3" aria-label={c.howToRead.title}>
        <li class="border-t pt-3 font-semibold" style="border-color: var(--color-line); color: var(--color-ink);">
          <span aria-hidden="true" class="font-mono" style="color: var(--color-secondary);">✓</span>
          {c.howToRead.values.builtIn}
        </li>
        <li class="border-t pt-3 font-semibold" style="border-color: var(--color-line); color: var(--color-ink);">
          <span aria-hidden="true" class="font-mono" style="color: var(--color-muted);">◐</span>
          {c.howToRead.values.optional}
        </li>
        <li class="border-t pt-3 font-semibold" style="border-color: var(--color-line); color: var(--color-ink);">
          <span aria-hidden="true" class="font-mono" style="color: var(--color-muted);">–</span>
          {c.howToRead.values.notInScope}
        </li>
      </ul>
      <p class="kicker mt-6">
        {c.reviewedOnLabel}: <time datetime={COMPARE_REVIEWED_ON}>{reviewedOn}</time>
      </p>
    </section>

    <Rule class="my-12" />

    <section aria-labelledby="compare-alternatives">
      <h2 id="compare-alternatives" class="font-display text-2xl font-semibold" style="color: var(--color-ink);">
        {c.alternativesTitle}
      </h2>
      {
        grouped.map((group) => (
          <div class="mt-8">
            <p class="kicker">{categoryLabel[group.category]}</p>
            <ul class="mt-3 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
              {group.items.map((alt) => (
                <li class="flex flex-col border p-5 transition hover:-translate-y-0.5" style="border-color: var(--color-line); background-color: var(--color-gray-50);">
                  <p class="kicker">{categoryLabel[group.category]}</p>
                  <h3 class="mt-3 font-display text-xl font-semibold" style="color: var(--color-ink);">
                    {c.alternatives[alt.id].name}
                  </h3>
                  <p class="mt-3 leading-relaxed" style="color: var(--color-ink);">
                    {c.alternatives[alt.id].whatItDoesWell}
                  </p>
                  <p class="mt-3 leading-relaxed" style="color: var(--color-muted);">
                    {c.alternatives[alt.id].audience}
                  </p>
                  <p class="mt-auto flex flex-wrap gap-x-4 gap-y-2 pt-6">
                    <a
                      href={`${prefix}/compare/${alt.id}`}
                      class="font-semibold underline decoration-1 underline-offset-4 transition hover:opacity-80"
                      style="color: var(--color-secondary);"
                    >
                      {c.profileCta}
                    </a>
                    <a
                      href={alt.homepage}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="font-semibold underline decoration-1 underline-offset-4 transition hover:opacity-80"
                      style="color: var(--color-ink);"
                    >
                      {c.officialSiteLabel}
                    </a>
                  </p>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </section>

    <Rule class="my-12" />

    <section aria-labelledby="compare-strengths">
      <h2 id="compare-strengths" class="font-display text-2xl font-semibold" style="color: var(--color-ink);">
        {c.dwpStrengths.title}
      </h2>
      <ul class="mt-6 grid gap-x-10 gap-y-6 md:grid-cols-2">
        {
          c.dwpStrengths.items.map((item) => (
            <li class="border-t pt-4" style="border-color: var(--color-line);">
              <h3 class="font-display text-lg font-semibold" style="color: var(--color-ink);">
                {item.title}
              </h3>
              <p class="mt-2 leading-relaxed" style="color: var(--color-muted);">
                {item.body}
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    <Rule class="my-12" />

    <section class="max-w-3xl" aria-labelledby="compare-limits">
      <h2 id="compare-limits" class="font-display text-2xl font-semibold" style="color: var(--color-ink);">
        {c.honestLimits.title}
      </h2>
      <p class="mt-3 text-lg leading-relaxed" style="color: var(--color-muted);">
        {c.honestLimits.body}
      </p>
    </section>

    <Rule class="my-12" />

    <section class="max-w-3xl" aria-labelledby="compare-correction">
      <Kicker>{c.correction.title}</Kicker>
      <h2 id="compare-correction" class="sr-only">{c.correction.title}</h2>
      <p class="mt-4 text-lg leading-relaxed" style="color: var(--color-muted);">
        {c.correction.body}
      </p>
      <div class="mt-6">
        <a
          href={issuesUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center rounded-sm border px-5 py-3 font-semibold transition hover:opacity-80"
          style="border-color: var(--color-line); color: var(--color-ink);"
        >
          {c.correction.ctaLabel}
        </a>
      </div>
    </section>

  </article>
</MainLayout>
