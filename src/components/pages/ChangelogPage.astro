---
import { getCollection } from 'astro:content';
import Kicker from '@/components/editorial/Kicker.astro';
import Lead from '@/components/editorial/Lead.astro';
import Rule from '@/components/editorial/Rule.astro';
import FormattedDate from '@/components/FormattedDate.astro';
import MainLayout from '@/layouts/MainLayout.astro';
import { getChangelogUrl, sortChangelogEntries } from '@/lib/changelog';
import { getUrlPrefix, type Language, stripEntryLangPrefix } from '@/lib/i18n';
import { getTranslations } from '@/lib/translations';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
const c = t.changelogPage;
const prefix = getUrlPrefix(lang);
const entries = sortChangelogEntries(
  (await getCollection('changelog')).filter((entry) => entry.data.lang === lang)
);
const siteUrl = Astro.site?.href?.replace(/\/$/, '') ?? '';

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: c.meta.title,
  description: c.meta.description,
  url: `${siteUrl}${prefix}/changelog`,
};
---

<MainLayout lang={lang} title={c.meta.title} description={c.meta.description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
  </Fragment>

  <article class="main-container py-16 md:py-24">
    <header class="max-w-3xl">
      <Kicker>{c.eyebrow}</Kicker>
      <h1
        class="font-display mt-4 text-4xl font-bold tracking-tight sm:text-5xl"
        style="color: var(--color-ink);"
      >
        {c.title}
      </h1>
      <Lead class="mt-6">{c.intro}</Lead>
    </header>

    <Rule class="my-12" />

    <ol class="relative ml-3 border-l md:ml-8" style="border-color: var(--color-line);">
      {
        entries.map((entry) => {
          const slug = stripEntryLangPrefix(entry.id);
          const isFeatured = entry.data.featured;
          return (
            <li class="relative pb-12 pl-8 last:pb-0 md:pl-12">
              <span
                class="absolute -left-[0.4375rem] top-1 h-3 w-3 rounded-full border-2 bg-paper"
                style={`border-color: ${isFeatured ? 'var(--color-secondary)' : 'var(--color-line)'};`}
                aria-hidden="true"
              ></span>
              <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
                <FormattedDate date={entry.data.date} lang={lang} />
                <span class="kicker" style="color: var(--color-secondary);">
                  {entry.data.version}
                </span>
                {isFeatured && <span class="kicker">{c.featuredLabel}</span>}
              </div>
              <h2
                class:list={[
                  'font-display mt-3 font-bold tracking-tight',
                  isFeatured ? 'text-3xl md:text-4xl' : 'text-2xl md:text-3xl',
                ]}
                style="color: var(--color-ink);"
              >
                <a href={getChangelogUrl(lang, slug)} class="hover:text-secondary">
                  {entry.data.title}
                </a>
              </h2>
              <p class="mt-3 max-w-2xl leading-relaxed" style="color: var(--color-muted);">
                {entry.data.description}
              </p>
              <a
                href={getChangelogUrl(lang, slug)}
                class="kicker mt-4 inline-flex items-center gap-2 hover:opacity-80"
                style="color: var(--color-secondary);"
              >
                {c.viewDetail} <span aria-hidden="true">→</span>
              </a>
            </li>
          );
        })
      }
    </ol>
  </article>
</MainLayout>
