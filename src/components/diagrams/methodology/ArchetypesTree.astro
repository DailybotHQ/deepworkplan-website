      'координує підрепозиторії',
      'плани делегують дочірнім планам',
      'стан .dwp/ між репозиторіями',
    ],
    wsPoints: [
      'осередок автономного агента',
      'сигнали OpenClaw / Hermes',
      'git необовʼязковий · state.json обовʼязковий',
    ],
    caption:
      'Спочатку класифікуйте ціль: окремий репозиторій обмежує плани локальними файлами, хаб координує підрепозиторії, а робочий простір забезпечує роботу автономних агентів.',
  },
  th: {
    ariaLabel:
      'แผนผังการตัดสินใจ: จัดประเภทเป็นที่เก็บเดี่ยว (ฐานโค้ดเดียว) ฮับผู้ประสานงาน (ประสานงานที่เก็บย่อย) หรือพื้นที่ทำงานของเอเจนต์ (รันไทม์เอเจนต์อัตโนมัติ)',
    root: 'ไดเรกทอรีเป้าหมาย',
    question: 'สัญญาณใดที่ได้รับการตรวจสอบบนดิสก์?',
    individual: 'ที่เก็บเดี่ยว',
    orchestrator: 'ฮับผู้ประสานงาน',
    workspace: 'พื้นที่ทำงานของเอเจนต์',
    edgeInd: 'ฐานโค้ดเดียว',
    edgeOrc: 'ที่เก็บซ้อนกัน',
    edgeWs: 'สัญญาณแพลตฟอร์ม',
    indPoints: [
      'ฐานโค้ดเดียว',
      'แผนแก้ไขไฟล์ในเครื่อง',
      '.dwp/ ที่รูทของที่เก็บ',
    ],
    orcPoints: [
      'ประสานงานที่เก็บย่อย',
      'แผนมอบหมายงานให้แผนย่อย',
      'สถานะ .dwp/ ข้ามที่เก็บ',
    ],
    wsPoints: [
      'แหล่งกำเนิดเอเจนต์อิสระ',
      'สัญญาณ OpenClaw / Hermes',
      'git ไม่บังคับ · ต้องมี state.json',
    ],
    caption:
      'จัดประเภทเป้าหมายก่อน: ที่เก็บเดี่ยวจำกัดขอบเขตแผนไว้ที่ไฟล์ในเครื่อง ฮับประสานงานดูแลที่เก็บย่อย และพื้นที่ทำงานขับเคลื่อนเอเจนต์อัตโนมัติ',
  },
} as const;

const t = i18n[lang as keyof typeof i18n] ?? i18n.en;
---

<figure class={`editorial-asset arch ${className}`} role="img" aria-label={t.ariaLabel}>
  <div class="editorial-asset__grid" aria-hidden="true"></div>
  <div class="editorial-asset__body">
    <!-- Root node: Target directory -->
    <div class="arch-root">
      <code>{t.root}</code>
    </div>

    <div class="arch-stem" aria-hidden="true"></div>

    <!-- Question node -->
    <div class="arch-question">
      <span class="arch-q-mark" aria-hidden="true">?</span>
      <span class="arch-q-text">{t.question}</span>
    </div>

    <!-- Fork connector: question -> drop -> bar across 3 branches -->
    <div class="arch-fork" aria-hidden="true">
      <span class="arch-fork-drop"></span>
      <span class="arch-fork-bar"></span>
    </div>

    <!-- Branches: Individual vs Orchestrator Hub vs Agent Workspace -->
    <div class="arch-branches">
      <div class="arch-branch">
        <span class="arch-leg" aria-hidden="true"></span>
        <span class="ea-label arch-edge">{t.edgeInd}</span>
        <div class="arch-leaf">
          <p class="arch-h">{t.individual}</p>
          <ul class="arch-points">
            {t.indPoints.map((p) => <li>{p}</li>)}
          </ul>
        </div>
      </div>
      <div class="arch-branch">
        <span class="arch-leg" aria-hidden="true"></span>
        <span class="ea-label arch-edge arch-edge--accent">{t.edgeOrc}</span>
        <div class="arch-leaf arch-leaf--accent">
          <p class="arch-h">{t.orchestrator}</p>
          <ul class="arch-points">
            {t.orcPoints.map((p) => <li>{p}</li>)}
          </ul>
        </div>
      </div>
      <div class="arch-branch">
        <span class="arch-leg" aria-hidden="true"></span>
        <span class="ea-label arch-edge">{t.edgeWs}</span>
        <div class="arch-leaf">
          <p class="arch-h">{t.workspace}</p>
          <ul class="arch-points">
            {t.wsPoints.map((p) => <li>{p}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </div>
  <figcaption class="fig-caption">{t.caption}</figcaption>
</figure>

<style>
  .arch {
    color: var(--color-ink);
  }
  .arch-root {
    width: max-content;
    margin: 0 auto;
    border: 1.5px solid var(--color-ink);
    border-radius: 6px;
    padding: 0.45rem 1.4rem;
    font-family: var(--font-serif);
    font-weight: 700;
  }
  .arch-stem {
    width: 1px;
    height: 1rem;
    margin: 0 auto;
    background-color: var(--color-line);
  }
  .arch-question {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: max-content;
    max-width: 100%;
    margin: 0 auto;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    padding: 0.35rem 1rem 0.35rem 0.45rem;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.9rem;
    text-align: left;
  }
  .arch-q-mark {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.3rem;
    height: 1.3rem;
    border-radius: 999px;
    background-color: var(--color-secondary);
    color: var(--color-paper);
    font-family: var(--font-serif);
    font-style: normal;
    font-weight: 700;
    font-size: 0.85rem;
  }

  /* Fork connector: question -> center drop -> bar -> a leg into each branch. */
  .arch-fork {
    position: relative;
    height: 1.1rem;
  }
  .arch-fork-drop {
    position: absolute;
    top: 0;
    left: 50%;
    width: 1px;
    height: 0.6rem;
    background-color: var(--color-line);
  }
  .arch-fork-bar {
    display: none;
  }
  @media (min-width: 680px) {
    .arch-fork-bar {
      display: block;
      position: absolute;
      top: 0.6rem;
      left: 16.66%;
      right: 16.66%;
      height: 1px;
      background-color: var(--color-line);
    }
  }
  .arch-branches {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.9rem;
  }
  @media (min-width: 680px) {
    .arch-branches {
      grid-template-columns: 1fr 1fr 1fr;
    }
  }
  .arch-branch {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
  }
  .arch-leg {
    width: 1px;
    height: 0.6rem;
    background-color: var(--color-line);
  }
  .arch-edge {
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
    border: 1px solid var(--color-line);
    border-radius: 999px;
    padding: 0.05rem 0.6rem;
    background-color: var(--color-paper);
  }
  .arch-edge--accent {
    color: var(--color-secondary);
    border-color: var(--color-secondary);
  }
  .arch-leaf {
    width: 100%;
    border: 1px solid var(--color-line);
    border-radius: 4px;
    padding: 0.85rem;
    background-color: var(--color-paper);
    height: 100%;
  }
  .arch-leaf--accent {
    border-color: var(--color-secondary);
  }
  .arch-h {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1rem;
    margin: 0 0 0.55rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--color-line);
  }
  .arch-leaf--accent .arch-h {
    color: var(--color-secondary);
    border-bottom-color: var(--color-secondary);
  }
  .arch-points {
    margin: 0;
    padding-left: 1.1rem;
  }
  .arch-points li {
    font-family: var(--font-serif);
    font-size: 0.85rem;
    line-height: 1.4;
    color: var(--color-muted);
  }
</style>
