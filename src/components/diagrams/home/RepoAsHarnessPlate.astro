const t = i18n[lang as keyof typeof i18n] ?? i18n.en;

// Split the statement around the emphasis word so the oxblood span binds
// `statementEmphasis` (an exact substring of `statement` in every locale —
// enforced by tests/unit/components/repo-as-harness-plate.test.ts).
const emIndex = t.statement.indexOf(t.statementEmphasis);
const statementBefore =
  emIndex >= 0 ? t.statement.slice(0, emIndex) : t.statement;
const statementAfter =
  emIndex >= 0 ? t.statement.slice(emIndex + t.statementEmphasis.length) : '';
---

<figure
  class={`editorial-asset editorial-plate ${className}`}
  role="img"
  aria-label={t.ariaLabel}
>
  <img
    src="/images/visuals/home/plate-repo-as-harness.png"
    alt={t.alt}
    width="1600"
    height="1000"
    loading="lazy"
    class="plate-frame-img dark:hidden"
  />
  <img
    src="/images/visuals/home/plate-repo-as-harness-dark.png"
    alt={t.alt}
    width="1600"
    height="1000"
    loading="lazy"
    class="plate-frame-img hidden dark:block"
  />
  <figcaption>
    <p class="plate-statement">
      {statementBefore}<span class="plate-statement-em">{t.statementEmphasis}</span>{statementAfter}
    </p>
    <ul class="plate-points">
      {t.points.map((point) => <li>{point}</li>)}
    </ul>
    <ul class="plate-tags">
      {t.tags.map((tag) => <li>{tag}</li>)}
    </ul>
  </figcaption>
</figure>

<style>
  /* Art layer: explicit 1600×1000 frame ratio (mirrors the shared
     .plate-frame-img rule) so the plate reserves its space with no CLS. */
  .plate-frame-img {
    aspect-ratio: 16 / 10;
  }

  /* Caption rhythm: statement, points, and tag chips stacked with a gap. */
  figcaption {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  /* Hang-tag chips — the engraved chest's five blank tags, labeled here in
     HTML instead of in the art. Small-caps serif chips on hairline rules,
     Broadsheet tokens only (no ad-hoc hex, no drop shadows). */
  .plate-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .plate-tags > li {
    border: 1px solid var(--color-line);
    border-radius: 4px;
    color: var(--color-muted);
    font-family: var(--font-serif);
    font-size: 0.85rem;
    font-variant-caps: small-caps;
    letter-spacing: 0.08em;
    line-height: 1.4;
    padding: 0.15rem 0.6rem;
  }
</style>
