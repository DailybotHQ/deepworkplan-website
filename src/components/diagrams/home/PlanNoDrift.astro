---
/**
 * PlanNoDrift — Act II plate of the homepage four-act story (inventory HP-07).
 *
 * "A plan agents can't drift from": a two-layer editorial plate. Layer one is
 * the transparent-background engraved raster pair (light + dark; the assets are
 * developer-generated and hard-gated at integration time). Layer two is real
 * HTML text from an inline 17-language i18n map with an `en` fallback — the
 * statement plus the five loop stages as an ordered list, because the sequence
 * (plan → atomic tasks → validation gates → completion → resumable state) is
 * the point. Static, zero JS; frame and text styling come from the shared
 * plate primitives in src/styles/global.css (.editorial-plate, .plate-frame-img,
 * .plate-statement, .plate-points, .ea-label).
 */
import type { Language } from '@/lib/i18n';

interface Props {
  lang?: Language;
  class?: string;
}

const { lang = 'en', class: className = '' } = Astro.props;

