  },
} as const;

const t = i18n[lang as keyof typeof i18n] ?? i18n.en;

// Normalize the per-locale tuple union so the template .map() type-checks.
const points: readonly string[] = t.points;

// Wrap the emphasized word by splitting the localized statement around it.
// statementEmphasis is an exact substring of statement in every locale — an
// invariant enforced by tests/unit/components/plan-no-drift.test.ts.
const emphasisStart = t.statement.indexOf(t.statementEmphasis);
const statementHead = t.statement.slice(0, emphasisStart);
const statementTail = t.statement.slice(
  emphasisStart + t.statementEmphasis.length
);
---

<figure
  class={`editorial-asset editorial-plate ${className}`}
  role="img"
  aria-label={t.ariaLabel}
>
  <img
    src="/images/visuals/home/plate-plan-no-drift.png"
    alt={t.alt}
    width="1600"
    height="1000"
    loading="lazy"
    class="plate-frame-img dark:hidden"
  />
  <img
    src="/images/visuals/home/plate-plan-no-drift-dark.png"
    alt={t.alt}
    width="1600"
    height="1000"
    loading="lazy"
    class="plate-frame-img hidden dark:block"
  />
  <figcaption>
    <p class="plate-statement">
      {statementHead}<span class="plate-statement-em">{t.statementEmphasis}</span>{statementTail}
    </p>
    <ol class="plate-points">
      {
        points.map((point) => (
          <li>
            <span class="ea-label">{point}</span>
          </li>
        ))
      }
    </ol>
  </figcaption>
</figure>
