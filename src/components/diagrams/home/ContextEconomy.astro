const t = i18n[lang as keyof typeof i18n] ?? i18n.en;
const emIndex = t.statement.indexOf(t.statementEmphasis);
const pre = emIndex > 0 ? t.statement.slice(0, emIndex) : t.statement;
const post =
  emIndex > 0 ? t.statement.slice(emIndex + t.statementEmphasis.length) : '';
---

<figure class={`editorial-asset editorial-plate ${className}`} role="img" aria-label={t.ariaLabel}>
  <img
    src="/images/visuals/home/plate-context-economy.png"
    alt={t.alt}
    width="1600"
    height="1000"
    loading="lazy"
    class="plate-frame-img dark:hidden"
  />
  <img
    src="/images/visuals/home/plate-context-economy-dark.png"
    alt={t.alt}
    width="1600"
    height="1000"
    loading="lazy"
    class="plate-frame-img hidden dark:block"
  />
  <div class="editorial-asset__body">
    <p class="plate-statement">
      {pre}<span class="plate-statement-em ea-accent">{t.statementEmphasis}</span>{post}
    </p>
    <ul class="plate-points">
      {
        t.points.map((point) => (
          <li>
            <span class="ea-label">{point}</span>
          </li>
        ))
      }
    </ul>
  </div>
</figure>
