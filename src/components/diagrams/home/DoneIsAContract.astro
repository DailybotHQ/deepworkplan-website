---
/**
 * DoneIsAContract — Act III plate of the homepage four-act story.
 *
 * A two-layer editorial asset: the text-free AI-engraved raster pair
 * (light/dark, 1600×1000, transparent background) as the art layer, plus real
 * HTML text from an inline language-keyed i18n map as the text layer. Unlike
 * the SVG-as-code diagrams, this one is illustration-led and reuses the
 * .editorial-asset / .editorial-plate frame family. Spec: HP-08
 * (analysis_results/ILLUSTRATION_PROMPTS.md).
 *
 * Static: no JS, no motion. role="img" with a localized aria-label; the art
 * pair keeps an explicit 16/10 aspect (no CLS) and dark mode swaps rasters
 * via Tailwind dark: utilities. See docs/DIAGRAM_COMPONENTS.md.
 */
import type { Language } from '@/lib/i18n';

interface Props {
  lang?: Language;
  class?: string;
}

