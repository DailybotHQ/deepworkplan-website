<figure
  class={`editorial-asset editorial-plate ${className}`}
  role="img"
  aria-label={t.ariaLabel}
>
  <img
    src="/images/visuals/home/plate-done-is-a-contract.png"
    alt={t.alt}
    width="1600"
    height="1000"
    loading="lazy"
    class="plate-frame-img dark:hidden"
  />
  <img
    src="/images/visuals/home/plate-done-is-a-contract-dark.png"
    alt={t.alt}
    width="1600"
    height="1000"
    loading="lazy"
    class="plate-frame-img hidden dark:block"
  />
  <figcaption>
    <p class="plate-statement">
      {statementBefore}<span class="plate-statement-em">{t.statementEmphasis}</span>{statementAfter}
    </p>
    <ul class="plate-points">
      {
        t.points.map((point) => (
          <li>
            <span class="ea-label">{point}</span>
          </li>
        ))
      }
    </ul>
  </figcaption>
</figure>

<style>
  /* Explicit art-frame aspect for the 1600×1000 rasters — no CLS. The shared
   * .plate-frame-img rule already carries it; the plate restates it so the
   * no-CLS contract holds in this component's own scope. */
  .plate-frame-img {
    aspect-ratio: 16 / 10;
  }
</style>
