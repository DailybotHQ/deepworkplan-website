const t = i18n[lang as keyof typeof i18n] ?? i18n.en;

// Split the statement around the emphasized word so the markup binds
// t.statementEmphasis (an exact substring of t.statement in every locale).
const emphasisAt = t.statement.indexOf(t.statementEmphasis);
const statementBefore =
  emphasisAt >= 0 ? t.statement.slice(0, emphasisAt) : t.statement;
const statementAfter =
  emphasisAt >= 0
    ? t.statement.slice(emphasisAt + t.statementEmphasis.length)
    : '';
