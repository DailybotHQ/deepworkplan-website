const t = i18n[lang as keyof typeof i18n] ?? i18n.en;
const last = t.stages.length - 1;
---

<figure
  class={`editorial-asset loopd ${className}`}
  role="img"
  aria-label={t.ariaLabel}
>
  <div class="editorial-asset__grid" aria-hidden="true"></div>
  <div class="editorial-asset__body">
    <p class="loopd-title kicker">{t.title}</p>
    <ol class="loopd-grid">
      {
        t.stages.map((stage, i) => (
          <li class={`loopd-node loopd-node--${i + 1}${i === last ? ' loopd-node--done' : ''}`}>
            <span class="loopd-num nums-tabular">
              {String(i + 1).padStart(2, '0')}
            </span>
            <span class="loopd-name">{stage.name}</span>
            <code class="loopd-code">{CODES[i]}</code>
            <span class="loopd-note">{stage.note}</span>
            {i < last && (
              <span class="loopd-arrow" aria-hidden="true" />
            )}
          </li>
        ))
      }
    </ol>
    <p class="loopd-foot">{t.footnote}</p>
  </div>
</figure>

<style>
  .loopd {
    color: var(--color-ink);
  }
  .loopd-title {
    margin: 0 0 0.9rem;
    color: var(--color-secondary);
  }
  .loopd-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.6rem;
  }
  .loopd-node {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
    border: 1px solid var(--color-line);
    border-radius: 4px;
    padding: 0.6rem 0.65rem;
    background-color: var(--color-paper);
  }
  .loopd-node--done {
    border-color: var(--color-secondary);
  }
  .loopd-num {
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--color-muted);
  }
  .loopd-node--done .loopd-num {
    color: var(--color-secondary);
  }
  .loopd-name {
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.2;
  }
  .loopd-code {
    font-size: 0.7rem;
    line-height: 1.3;
    color: var(--color-ink);
    overflow-wrap: anywhere;
  }
  .loopd-note {
    font-size: 0.78rem;
    line-height: 1.3;
    color: var(--color-muted);
  }
  .loopd-arrow {
    display: none;
  }
  .loopd-foot {
    margin: 0.9rem 0 0;
    font-size: 0.8rem;
    line-height: 1.4;
    color: var(--color-muted);
  }

  /* Serpentine on wider plates: 1 → 2 → 3, then ↓, then 4 ← 5 ← 6 reads back. */
  @media (min-width: 640px) {
    .loopd-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: 1.4rem;
      row-gap: 1.4rem;
    }
    .loopd-node--4 {
      grid-column: 3;
      grid-row: 2;
    }
    .loopd-node--5 {
      grid-column: 2;
      grid-row: 2;
    }
    .loopd-node--6 {
      grid-column: 1;
      grid-row: 2;
    }
    .loopd-arrow {
      display: block;
      position: absolute;
      color: var(--color-muted);
      font-size: 0.9rem;
      line-height: 1;
    }
    .loopd-node--1 .loopd-arrow,
    .loopd-node--2 .loopd-arrow {
      top: 50%;
      right: -1.15rem;
      transform: translateY(-50%);
    }
    .loopd-node--1 .loopd-arrow::before,
    .loopd-node--2 .loopd-arrow::before {
      content: '→';
    }
    .loopd-node--3 .loopd-arrow {
