---
/**
 * LoopDiagram — the homepage hero plate for loop engineering: how an open plan
 * runs to its end. Registration → daemon → nudge → failover → notify → done.
 *
 * Every stage is a released contract of herdr-peers (the pin in
 * src/lib/ecosystem-pins.ts): `lead claim` (protocol.md §12), the human-started
 * `autopilot --loop` (autopilot.md §1, §5), the one fixed continue prompt to a
 * lead idle for 5 minutes (§5.2–5.3), `lead takeover` by the first reachable
 * successor (§5.2), the `plan-event-v1` object sent to the human's `--notify`
 * command (§8), and `plan_completed`. The stage codes are literal and never
 * translated. HTML/CSS; language-keyed i18n (en fallback); role="img"; dark
 * mode through tokens; zero JS.
 */
import type { Language } from '@/lib/i18n';

interface Props {
  lang?: Language;
  class?: string;
}
const { lang = 'en', class: className = '' } = Astro.props;

/** Literal stage codes, in stage order — identical in every language. */
const CODES = [
  'lead claim',
  'autopilot --loop',
  'idle ≥ 5 min',
  'lead takeover',
  'plan-event-v1',
  'plan_completed',
] as const;

