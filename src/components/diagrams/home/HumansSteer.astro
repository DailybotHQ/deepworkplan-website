---
/**
 * HumansSteer — Act I plate of the home four-act narrative (two-layer).
 *
 * Layer 1 (art): an engraved, text-free raster pair fixed by the plan's prompt
 * pack — light ink on paper plus a dark-mode variant, transparent background,
 * 16:10. Layer 2 (text): real HTML — the localized statement with one
 * oxblood-emphasized word and three point rows — driven by an inline
 * language-keyed i18n map with an `en` fallback (docs/DIAGRAM_COMPONENTS.md
 * §4; adding a language = adding a key). The statement is a paragraph, never a
 * heading: the figure is role="img", so its aria-label carries the content and
 * the visual text is presentational. No JS, no motion.
 */
import type { Language } from '@/lib/i18n';

interface Props {
  lang?: Language;
  class?: string;
}

