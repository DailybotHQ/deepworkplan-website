const t = i18n[lang as keyof typeof i18n] ?? i18n.en;

// Split the statement around the first occurrence of the emphasized word so
// each language keeps its own word order around the single oxblood accent.
const emStart = t.statement.indexOf(t.statementEmphasis);
const emFound = emStart !== -1;
const statementHead = emFound ? t.statement.slice(0, emStart) : '';
const statementTail = emFound
  ? t.statement.slice(emStart + t.statementEmphasis.length)
  : t.statement;

// The leading "Label:" segment (ASCII or full-width colon) becomes the
// small-caps row label; rows without a colon render as plain text.
const splitLabel = (point: string): { label: string; text: string } => {
  const colon = point.search(/[:：]/);
  if (colon === -1) {
    return { label: '', text: point };
  }
  return { label: point.slice(0, colon + 1), text: point.slice(colon + 1) };
};

const pointRows = t.points.map(splitLabel);
---

<figure class={`editorial-asset editorial-plate ${className}`} role="img" aria-label={t.ariaLabel}>
  <img
    src="/images/visuals/home/plate-humans-steer.png"
    alt={t.alt}
    width="1600"
    height="1000"
    loading="lazy"
    class="plate-frame-img dark:hidden"
  />
  <img
    src="/images/visuals/home/plate-humans-steer-dark.png"
    alt={t.alt}
    width="1600"
    height="1000"
    loading="lazy"
    class="plate-frame-img hidden dark:block"
  />
  <p class="plate-statement">
    {statementHead}{emFound && <span class="plate-statement-em ea-accent">{t.statementEmphasis}</span>}{statementTail}
  </p>
  <ul class="plate-points">
    {
      pointRows.map((row) => (
        <li>{row.label && <span class="ea-label">{row.label}</span>}{row.text}</li>
      ))
    }
  </ul>
</figure>
