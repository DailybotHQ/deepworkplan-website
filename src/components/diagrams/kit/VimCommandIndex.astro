---

<figure class={`editorial-asset vimidx ${className}`} role="img" aria-label={t.aria}>
  <div class="editorial-asset__grid" aria-hidden="true"></div>
  <div class="editorial-asset__body">
    <div class="vimidx-plate">
      <div class="vimidx-head">
        <kbd class="vimidx-key ea-accent">{chords[0]}</kbd>
        <span class="vimidx-title">{t.heading}</span>
        <span class="vimidx-hint">{t.hint}</span>
      </div>
      <ul class="vimidx-rows">
        {
          chords.map((chord, index) => (
            <li class="vimidx-row">
              <kbd class="vimidx-chord">{chord}</kbd>
              <span class="vimidx-label">{t.rows[index]}</span>
            </li>
          ))
        }
        <li class="vimidx-row vimidx-more">
          <span class="vimidx-chord" aria-hidden="true">…</span>
          <span class="vimidx-label">{t.more}</span>
        </li>
      </ul>
    </div>
  </div>
  <figcaption class="fig-caption">{t.caption}</figcaption>
