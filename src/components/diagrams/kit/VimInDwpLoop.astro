---
/**
 * VimInDwpLoop — where DeepWorkPlan Vim sits in the Deep Work Plan loop: the
 * plan browser (SPC P) reads plans under .dwp/plans/ and the Markdown viewer
 * (SPC m p / SPC m r) previews a plan's files. Read-only: the editor never
 * writes under .dwp/. Claims limited to the plan's claims ledger (C-04, C-05,
 * C-07). HTML/CSS; language-keyed i18n (en fallback); role="img"; dark mode;
 * zero JS. Spec: docs/DIAGRAM_COMPONENTS.md.
 */
import type { Language } from '@/lib/i18n';

interface Props {
  lang?: Language;
  class?: string;
}
const { lang = 'en', class: className = '' } = Astro.props;

// Keybindings are code: identical in every language.
const browserChord = 'SPC P';
const viewerChords = 'SPC m p · SPC m r';

