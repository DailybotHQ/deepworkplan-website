const t = i18n[lang as keyof typeof i18n] ?? i18n.en;
---

<figure class={`editorial-asset vimloop ${className}`} role="img" aria-label={t.aria}>
  <div class="editorial-asset__grid" aria-hidden="true"></div>
  <div class="editorial-asset__body">
    <ol class="vimloop-flow">
      {
        t.steps.map((step, index) => (
          <li class="vimloop-item">
            <span class={`vimloop-step${index === t.steps.length - 1 ? ' ea-accent' : ''}`}>{step}</span>
            {index < t.steps.length - 1 && (
              <span class="vimloop-arrow" aria-hidden="true">→</span>
            )}
          </li>
        ))
      }
    </ol>
    <div class="vimloop-editor">
      <span class="kicker vimloop-editor-title">{t.editor}</span>
      <div class="vimloop-cards">
        <div class="vimloop-card">
          <span class="vimloop-card-title">{t.browserTitle}</span>
          <kbd class="vimloop-chord">{browserChord}</kbd>
          <span class="vimloop-card-body">{t.browserBody}</span>
        </div>
        <div class="vimloop-card">
          <span class="vimloop-card-title">{t.viewerTitle}</span>
          <kbd class="vimloop-chord">{viewerChords}</kbd>
          <span class="vimloop-card-body">{t.viewerBody}</span>
        </div>
      </div>
    </div>
  </div>
  <figcaption class="fig-caption">{t.caption}</figcaption>
</figure>

<style>
  .vimloop {
    color: var(--color-ink);
  }
  .vimloop-flow {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.4rem;
  }
  @media (min-width: 720px) {
    .vimloop-flow {
      flex-direction: row;
      align-items: center;
      justify-content: center;
      gap: 0.6rem;
    }
  }
  .vimloop-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    min-width: 0;
  }
  @media (min-width: 720px) {
    .vimloop-item {
      flex-direction: row;
      gap: 0.6rem;
    }
  }
  .vimloop-step {
    display: block;
    width: 100%;
    border: 1px solid var(--color-ink);
    border-radius: 4px;
    padding: 0.5rem 1rem;
    text-align: center;
    font-family: var(--font-serif);
    font-weight: 600;
    background-color: var(--color-paper);
    overflow-wrap: anywhere;
  }
  @media (min-width: 720px) {
    .vimloop-step {
      width: auto;
    }
  }
  .vimloop-step.ea-accent {
    border-color: var(--color-secondary);
    border-width: 1.5px;
  }
  .vimloop-arrow {
    font-size: 1.1rem;
    transform: rotate(90deg);
  }
  @media (min-width: 720px) {
    .vimloop-arrow {
      transform: none;
    }
  }
  .vimloop-editor {
    margin-top: 1.1rem;
    border-top: 1px solid var(--color-ink);
    padding-top: 0.7rem;
    min-width: 0;
  }
  .vimloop-cards {
    margin-top: 0.6rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.75rem;
  }
  @media (min-width: 720px) {
    .vimloop-cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .vimloop-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
    border: 1px solid var(--color-line);
    border-radius: 4px;
    padding: 0.7rem 0.9rem;
    background-color: var(--color-paper);
    min-width: 0;
  }
  .vimloop-card-title {
    font-family: var(--font-serif);
    font-weight: 700;
    overflow-wrap: anywhere;
  }
  .vimloop-chord {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    border: 1px solid var(--color-secondary);
    border-radius: 3px;
    padding: 0.05rem 0.4rem;
    max-width: 100%;
    overflow-wrap: anywhere;
  }
  .vimloop-card-body {
    font-family: var(--font-serif);
    font-size: 0.88rem;
    color: var(--color-muted);
    overflow-wrap: anywhere;
  }
</style>
