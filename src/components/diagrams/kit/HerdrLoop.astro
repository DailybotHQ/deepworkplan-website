const t = i18n[lang as keyof typeof i18n] ?? i18n.en;
const steps = t.steps;
---

<figure class:list={['editorial-asset herdr-loop', className]} role="img" aria-label={t.aria}>
  <div class="editorial-asset__grid" aria-hidden="true"></div>
  <div class="editorial-asset__body">
    <p class="herdr-loop__title">{t.title}</p>
    <ol class="herdr-loop__steps">
      {steps.map((step, index) => (
        <li class="herdr-loop__step">
          <span class="herdr-loop__number">0{index + 1}</span>
          <span>{step}</span>
        </li>
      ))}
    </ol>
    <figcaption class="fig-caption">{t.caption}</figcaption>
  </div>
</figure>

<style>
  .herdr-loop {
    aspect-ratio: 16 / 7;
    min-height: 13rem;
    color: var(--color-ink);
  }

  .herdr-loop__title {
    margin: 0 0 1rem;
    color: var(--color-secondary);
    font-family: var(--font-serif);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .herdr-loop__steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-line);
    border-left: 1px solid var(--color-line);
  }

  .herdr-loop__step {
    display: flex;
    min-height: 4.5rem;
    align-items: baseline;
    gap: 0.6rem;
    padding: 0.8rem 0.9rem;
    border-right: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
    font-family: var(--font-serif);
    line-height: 1.35;
  }

  .herdr-loop__number {
    flex: 0 0 auto;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }

  .fig-caption {
    margin-top: 0.75rem;
    color: var(--color-muted);
    font-family: var(--font-serif);
    font-size: 0.875rem;
    line-height: 1.45;
  }

  @media (max-width: 640px) {
    .herdr-loop {
      aspect-ratio: 1 / 1;
      min-height: 22rem;
    }

    .herdr-loop__steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .herdr-loop__step {
      min-height: 4.75rem;
      padding: 0.7rem 0.55rem;
      font-size: 0.9rem;
    }
  }
</style>
