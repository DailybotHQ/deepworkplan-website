---
import HumansSteer from '@/components/diagrams/home/HumansSteer.astro';
import type { Language } from '@/lib/i18n';
import { getUrlPrefix } from '@/lib/i18n';
import { getTranslations } from '@/lib/translations';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
const prefix = getUrlPrefix(lang);
const a = t.home.story.act1;
---

<section id="how-it-works" class="border-b py-16 md:py-20" style="border-color: var(--color-line);">
  <div class="main-container">
    <h2 class="kicker flex items-center gap-3">
      <span>{a.kicker}</span>
      <span class="h-px w-8 shrink-0 bg-secondary" aria-hidden="true"></span>
    </h2>
    <p class="lead mt-4">{a.lead}</p>

    <HumansSteer lang={lang} class="mt-10" />

    <a
      href={`${prefix}${a.deepLinkHref}`}
      class="mt-8 inline-flex items-center text-base font-semibold transition hover:opacity-70"
      style="color: var(--color-secondary);"
    >
      {a.deepLinkLabel} &rarr;
    </a>
  </div>
</section>
