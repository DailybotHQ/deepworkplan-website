---
import Kicker from '@/components/editorial/Kicker.astro';
import Lead from '@/components/editorial/Lead.astro';
import type { Language } from '@/lib/i18n';
import { getTranslations } from '@/lib/translations';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
const p = t.home.pitch;
---

<section id="problem-answer" class="border-b py-16 md:py-20" style="border-color: var(--color-line);">
  <div
    class="main-container flex flex-col lg:grid lg:grid-cols-[minmax(0,420px)_minmax(0,1fr)] lg:items-center lg:gap-12"
  >
    <div class="order-2 mt-10 lg:order-1 lg:mt-0">
      <img
        src="/images/visuals/home/plate-pitch-problem.png"
        alt={p.illustrationAlt}
        width="1040"
        height="1300"
        loading="lazy"
        class="mx-auto h-auto w-full max-w-[320px] sm:max-w-[380px] dark:hidden"
      />
      <img
        src="/images/visuals/home/plate-pitch-problem-dark.png"
        alt={p.illustrationAlt}
        width="1040"
        height="1300"
        loading="lazy"
        class="mx-auto hidden h-auto w-full max-w-[320px] sm:max-w-[380px] dark:block"
      />
    </div>
    <div class="order-1 max-w-3xl lg:order-2">
      <Kicker>{p.kicker}</Kicker>
      <div class="mt-6 space-y-5">
        <Lead dropCap>{p.problem}</Lead>
        <p class="text-lg leading-relaxed" style="color: var(--color-ink);">
          {p.answer}
        </p>
      </div>
    </div>
  </div>
</section>
