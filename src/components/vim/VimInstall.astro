      'Виведіть його SHA-256 і порівняйте зі значенням нижче',
      'Прочитайте скрипт',
      'Запустіть скрипт',
    ],
    digestLabel: 'SHA-256 скрипта, який віддається зараз',
    bytesLabel: 'байтів',
    linesLabel: 'рядків',
    macNote:
      'У macOS на другому кроці використовуйте shasum -a 256 install.sh.',
    windowsNote:
      'У Windows однорядкова команда не застосовується; ручний шлях описано в README репозиторію.',
    windowsLink: 'Шлях встановлення для Windows',
    pinNote:
      'Щоб встановити певну гілку, тег або коміт, задайте DWP_VIM_REF. Старі теги можуть не містити всіх можливостей, описаних на цій сторінці.',
  },
  th: {
    copy: 'คัดลอกคำสั่ง',
    copied: 'คัดลอกแล้ว',
    consent:
      'ขอความยินยอมก่อน: การตั้งค่า Neovim ที่มีอยู่จะไม่ถูกเขียนทับโดยที่คุณไม่อนุมัติ ตัวติดตั้งจะถามก่อน และหากถามไม่ได้ก็จะหยุดโดยไม่เปลี่ยนแปลงอะไร',
    inspectTitle: 'ตรวจสอบก่อนรัน',
    inspectIntro:
      'ต้องการอ่านก่อนหรือไม่ ดาวน์โหลดสคริปต์ ตรวจสอบลายนิ้วมือ อ่านเนื้อหา แล้วจึงรัน',
    steps: [
      'ดาวน์โหลดสคริปต์',
      'แสดงค่า SHA-256 แล้วเทียบกับค่าด้านล่าง',
      'อ่านสคริปต์',
      'รันสคริปต์',
    ],
    digestLabel: 'SHA-256 ของสคริปต์ที่ให้บริการอยู่ตอนนี้',
    bytesLabel: 'ไบต์',
    linesLabel: 'บรรทัด',
    macNote: 'บน macOS ให้ใช้ shasum -a 256 install.sh ในขั้นตอนที่สอง',
    windowsNote:
      'บน Windows คำสั่งบรรทัดเดียวใช้ไม่ได้ ขั้นตอนแบบแมนนวลอยู่ใน README ของที่เก็บโค้ด',
    windowsLink: 'วิธีติดตั้งบน Windows',
    pinNote:
      'หากต้องการติดตั้งแบรนช์ แท็ก หรือคอมมิตที่ระบุ ให้ตั้งค่า DWP_VIM_REF แท็กรุ่นเก่าอาจไม่มีฟีเจอร์ทั้งหมดที่อธิบายในหน้านี้',
  },
} as const;
const t = i18n[lang as keyof typeof i18n] ?? i18n.en;

const facts = getInstallerFacts();
const stepCommands = [
  `curl -fsSL ${VIM_INSTALL_URL} -o install.sh`,
  'sha256sum install.sh',
  'less install.sh',
  'bash install.sh',
];
---

<div class={`vim-install not-prose ${className}`}>
  <div class="vim-install__frame">
    <div class="vim-install__bar">
      <span class="kicker">bash</span>
      <button
        type="button"
        class="vim-install__copy kicker"
        data-copy={VIM_INSTALL_COMMAND}
        data-label={t.copy}
        data-copied={t.copied}
        aria-label={t.copy}
      >
        {t.copy}
      </button>
    </div>
    <pre class="vim-install__pre"><code>{VIM_INSTALL_COMMAND}</code></pre>
  </div>
  <p class="vim-install__status" role="status" aria-live="polite" data-copy-status></p>

  <p class="vim-install__consent">{t.consent}</p>

  <details class="vim-install__inspect" id="inspect-before-you-run">
    <summary>{t.inspectTitle}</summary>
    <p class="vim-install__intro">{t.inspectIntro}</p>
    <ol class="vim-install__steps">
      {
        t.steps.map((label, index) => (
          <li>
            <span class="vim-install__step-label">{label}</span>
            <pre class="vim-install__pre vim-install__pre--step"><code>{stepCommands[index]}</code></pre>
          </li>
        ))
      }
    </ol>
    <dl class="vim-install__facts">
      <div>
        <dt>{t.digestLabel}</dt>
        <dd><code class="vim-install__digest">{facts.sha256}</code></dd>
      </div>
      <div>
        <dd>{facts.bytes} {t.bytesLabel} · {facts.lines} {t.linesLabel}</dd>
      </div>
    </dl>
    <p class="vim-install__note">{t.macNote}</p>
  </details>

  <p class="vim-install__note">{t.pinNote}</p>
  <p class="vim-install__note">
    {t.windowsNote}
    <a href={VIM_REPO_INSTALL_URL}>{t.windowsLink}</a>
  </p>
</div>

<style>
  .vim-install {
    margin-block: 1.5rem;
    color: var(--color-ink);
    min-width: 0;
  }
  .vim-install__frame {
    border: 1px solid var(--color-line);
    overflow: hidden;
    min-width: 0;
  }
  .vim-install__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.4rem 0.75rem;
    border-bottom: 1px solid var(--color-line);
    background-color: var(--color-gray-100);
  }
  .vim-install__copy {
    cursor: pointer;
    border: 0;
    background: transparent;
    color: var(--color-secondary);
    padding: 0.25rem 0.5rem;
    border-radius: 2px;
  }
  .vim-install__copy:hover:not(:disabled) {
    opacity: 0.8;
  }
  .vim-install__copy:disabled {
    cursor: default;
    opacity: 0.7;
  }
  .vim-install__copy:focus-visible,
  .vim-install__inspect summary:focus-visible {
    outline: 2px solid var(--color-secondary);
    outline-offset: 2px;
  }
  .vim-install__pre {
    margin: 0;
    padding: 0.75rem;
    overflow-x: auto;
    background-color: var(--color-gray-100);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--color-ink);
  }
  .vim-install__pre code {
    font-family: inherit;
    background: none;
    padding: 0;
  }
  .vim-install__status {
    margin: 0;
    min-height: 0;
    font-size: 0.8125rem;
    color: var(--color-muted);
  }
  .vim-install__consent {
    margin: 1rem 0 0;
    padding-left: 1rem;
    border-left: 2px solid var(--color-secondary);
    color: var(--color-muted);
    line-height: 1.7;
  }
  .vim-install__inspect {
    margin-top: 1.25rem;
    border: 1px solid var(--color-line);
    padding: 0 1rem;
    min-width: 0;
  }
  .vim-install__inspect summary {
    cursor: pointer;
    padding: 0.75rem 0;
    font-family: var(--font-serif);
    font-weight: 600;
    color: var(--color-ink);
  }
  .vim-install__inspect[open] summary {
    border-bottom: 1px solid var(--color-line);
  }
  .vim-install__intro {
    margin: 0.75rem 0;
    color: var(--color-muted);
    line-height: 1.7;
  }
  .vim-install__steps {
    margin: 0;
    padding-left: 1.25rem;
    display: grid;
    gap: 0.75rem;
  }
  .vim-install__steps li {
    min-width: 0;
  }
  .vim-install__step-label {
    display: block;
    margin-bottom: 0.25rem;
    font-family: var(--font-serif);
  }
  .vim-install__pre--step {
    border: 1px solid var(--color-line);
  }
  .vim-install__facts {
    margin: 1rem 0 0;
    display: grid;
    gap: 0.5rem;
    min-width: 0;
  }
  .vim-install__facts dt {
    font-family: var(--font-serif);
    font-size: 0.8125rem;
    color: var(--color-muted);
  }
  .vim-install__facts dd {
    margin: 0;
    min-width: 0;
    font-size: 0.8125rem;
  }
  .vim-install__digest {
    display: block;
    overflow-wrap: anywhere;
    word-break: break-all;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.6;
    color: var(--color-ink);
    background: none;
    padding: 0;
  }
  .vim-install__note {
    margin: 0.75rem 0 0;
    color: var(--color-muted);
    line-height: 1.7;
    font-size: 0.9375rem;
  }
  .vim-install__inspect > .vim-install__note {
    padding-bottom: 0.75rem;
  }
  .vim-install__note a {
    color: var(--color-secondary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>

<script>
  // Progressive enhancement: copy the one-liner, and open the "inspect before
  // you run" disclosure when the page is opened on its anchor.
  const FEEDBACK_MS = 2000;

  document.querySelectorAll<HTMLButtonElement>('.vim-install__copy').forEach((btn) => {
    let busy = false;
    const status = btn
      .closest('.vim-install')
      ?.querySelector<HTMLElement>('[data-copy-status]');

    btn.addEventListener('click', async () => {
      if (busy || btn.disabled) return;
      const text = btn.dataset.copy ?? '';
      const label = btn.dataset.label ?? '';
      const copied = btn.dataset.copied ?? '';
      busy = true;
      try {
        await navigator.clipboard.writeText(text);
        btn.disabled = true;
        btn.textContent = copied;
        btn.setAttribute('aria-label', copied);
        if (status) status.textContent = copied;
        window.setTimeout(() => {
          btn.disabled = false;
          btn.textContent = label;
          btn.setAttribute('aria-label', label);
          if (status) status.textContent = '';
          busy = false;
        }, FEEDBACK_MS);
      } catch {
        busy = false;
      }
    });
  });

  const openOnHash = () => {
    if (window.location.hash !== '#inspect-before-you-run') return;
    const details = document.getElementById('inspect-before-you-run');
    if (details instanceof HTMLDetailsElement) details.open = true;
  };
  openOnHash();
  window.addEventListener('hashchange', openOnHash);
</script>
