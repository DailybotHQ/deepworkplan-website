# Runtime environment for the dwpwebsite container.
#
# `bash dev.sh up` (dck setup) copies this file to .env (mode 0600, gitignored)
# when it is missing. Put secrets in .env only, never in this example. Format:
# KEY=value, no shell expansion. Compose loads .env when the container is
# created; sessions opened over ssh or Herdr see it through dck's environment
# profile, and every new bash re-reads it (docker/custom_commands.sh), so after
# editing it a new shell is enough.

ASTRO_TELEMETRY_DISABLED=1

# Analytics (optional locally)
PUBLIC_UMAMI_WEBSITE_ID=
PUBLIC_BING_SITE_VERIFICATION=

# --- Coding agents (coding-agents-kit `ak`) ---------------------------------
# Every agent launched through ak (claudex, codexx, claude-glm, codex-azure, …)
# runs in autonomy by default: this container is the sandbox.
# Opt-out — agents ask before acting:
# AGENTKIT_PERMISSIONS=ask
#
# Z.AI GLM Coding Plan (claude-glm, codex-glm, opencode-glm, pi-glm)
# API key: https://z.ai/manage-apikey/apikey-list
ZAI_CODING_API_KEY=
# ZAI_DEFAULT_SONNET_MODEL=glm-5.3
# ZAI_DEFAULT_OPUS_MODEL=glm-5.3
# ZAI_DEFAULT_HAIKU_MODEL=glm-5.3-flash
#
# xAI (codex-xai, opencode-xai, pi-xai, cline-xai, grok)
# API key: https://console.x.ai/
XAI_API_KEY=
# XAI_MODEL_DAILY=grok-4.3
# XAI_MODEL_REASONING=grok-4.6
#
# Azure OpenAI / Microsoft Foundry (codex-azure, opencode-azure, pi-azure, cline-azure)
AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_RESOURCE=<your-resource-name>     # or AZURE_OPENAI_BASE_URL=
# AZURE_OPENAI_BASE_URL=https://<your-resource-name>.services.ai.azure.com/openai/v1
AZURE_OPENAI_MODEL_DAILY=
# AZURE_OPENAI_MODEL_REASONING=

# Other project keys
TYPESAFE_API_KEY=

# --- Git identity inside the container --------------------------------------
# `dck setup` fills these from your host's git config when they are missing. The
# container's global git config is written from them at every start, so no host
# file is mounted. Only SSH signing is copied (gpg.format=ssh with a key:: key):
# it signs through the host's SSH agent.
# DCK_GIT_NAME=
# DCK_GIT_EMAIL=
# DCK_GIT_SIGNINGKEY=
# DCK_GIT_GPG_FORMAT=
# DCK_GIT_COMMIT_GPGSIGN=
