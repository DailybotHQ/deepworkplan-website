# Project env vars
#
# Read three ways (see docker/local/README.md → "How .env reaches your shell"):
# compose env_file at create time, /etc/environment for SSH logins (entrypoint),
# and re-read by every new bash (custom_commands.sh) — so after editing this
# file, opening a new shell is enough. Format: KEY=value, no shell expansion.
ASTRO_TELEMETRY_DISABLED=1

# Analytics
PUBLIC_UMAMI_WEBSITE_ID=
PUBLIC_BING_SITE_VERIFICATION=

# Z.AI GLM Coding Plan (optional local AI coding agents)
# Coding Plan API key: https://z.ai/manage-apikey/apikey-list
# Used by claude-glm / claudex-glm / opencodex-glm / codex-glm / pi-glm.
# Wizard: chelper  (or pnpm dlx @z_ai/coding-helper)
ZAI_CODING_API_KEY=
# Optional override (ms). Default matches Z.AI Claude Code docs.
# ZAI_CODING_API_TIMEOUT_MS=3000000
# Model mapping shared by claude-glm / claudex-glm / opencodex-glm / codex-glm / pi-glm.
# Defaults: opus/sonnet → glm-5.3, haiku → glm-5.3-flash. See https://docs.z.ai/devpack/latest-model
# ZAI_DEFAULT_OPUS_MODEL=glm-5.3
# ZAI_DEFAULT_SONNET_MODEL=glm-5.3
# ZAI_DEFAULT_HAIKU_MODEL=glm-5.3-flash
# OpenCode default when starting opencodex-glm (sonnet by default)
# ZAI_OPENCODE_DEFAULT_MODEL=glm-5.3
# Codex default when starting codex-glm (sonnet by default)
# ZAI_CODEX_DEFAULT_MODEL=glm-5.3
# Pi default when starting pi-glm (sonnet by default)
# ZAI_PI_DEFAULT_MODEL=glm-5.3
# Optional Codex Responses base URL (default below — required wire_api=responses)
# ZAI_CODEX_BASE_URL=https://api.z.ai/api/v1
# Optional Coding Plan OpenAI-compatible base URL for OpenCode / Pi (default below)
# ZAI_CODING_BASE_URL=https://api.z.ai/api/coding/paas/v4
# For 1M context use e.g. glm-5.3[1m] above and:
# ZAI_CODING_AUTO_COMPACT_WINDOW=1000000

# Azure OpenAI / Microsoft Foundry — used by opencodex-azure / clinex-azure / codex-azure / pi-azure
# Same fields as Cursor → Settings → Models → Azure OpenAI.
# OpenCode docs: https://opencode.ai/docs/providers/#azure-openai
# Codex docs: https://learn.microsoft.com/en-us/azure/foundry/openai/how-to/codex
# Pi docs: https://pi.dev/docs/latest/providers
AZURE_OPENAI_RESOURCE=dailybot-ai-prod-proj-resource
AZURE_OPENAI_BASE_URL=https://dailybot-ai-prod-proj-resource.services.ai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=
# Deployment names in Azure (exact match)
AZURE_OPENAI_MODEL_DAILY=gpt-5.4-mini-azure
AZURE_OPENAI_MODEL_REASONING=gpt-5.4-azure
# Default model when starting *-azure wrappers (daily by default)
# AZURE_OPENAI_DEFAULT_MODEL=gpt-5.4-mini-azure
# Optional Foundry image-gen deployment name for Codex header workaround (dummy ok)
# AZURE_OPENAI_IMAGE_DEPLOYMENT=gpt-image-1

# xAI / Grok API credits (https://console.x.ai/)
# Used by opencodex-xai / cline-xai / pi-xai / codex-xai / claudex-xai.
# Docs: https://docs.x.ai/developers/quickstart · https://docs.x.ai/developers/models
XAI_API_KEY=
# Optional OpenAI-compatible base (default below)
# XAI_BASE_URL=https://api.x.ai/v1
# Optional Anthropic-compatible base for claudex-xai (default https://api.x.ai)
# XAI_ANTHROPIC_BASE_URL=https://api.x.ai
# Model whitelist (daily / reasoning). Defaults match xAI coding guidance.
# XAI_MODEL_DAILY=grok-4.3
# XAI_MODEL_REASONING=grok-4.6
# Default model when starting *-xai wrappers (daily by default)
# XAI_DEFAULT_MODEL=grok-4.3

# JEV Typesafe
TYPESAFE_API_KEY=
