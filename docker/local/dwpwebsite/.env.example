# Project env vars
ASTRO_TELEMETRY_DISABLED=1

# Analytics
PUBLIC_UMAMI_WEBSITE_ID=
PUBLIC_BING_SITE_VERIFICATION=

# Z.AI GLM Coding Plan (optional local AI coding agents)
# Coding Plan API key: https://z.ai/manage-apikey/apikey-list
# Used by claude-glm / claudex-glm. OpenCode: opencode auth login → Z.AI Coding Plan.
# Wizard: chelper  (or pnpm dlx @z_ai/coding-helper)
ZAI_CODING_API_KEY=
# Optional override (ms). Default matches Z.AI Claude Code docs.
# ZAI_CODING_API_TIMEOUT_MS=3000000
# Process-scoped model mapping for claude-glm / claudex-glm only (not settings.json).
# Defaults: opus/sonnet → glm-5.3, haiku → glm-5.3-flash. See https://docs.z.ai/devpack/latest-model
# ZAI_DEFAULT_OPUS_MODEL=glm-5.3
# ZAI_DEFAULT_SONNET_MODEL=glm-5.3
# ZAI_DEFAULT_HAIKU_MODEL=glm-5.3-flash
# For 1M context use e.g. glm-5.3[1m] above and:
# ZAI_CODING_AUTO_COMPACT_WINDOW=1000000

