# Compose interpolates these into Dockerfile build args (docker/local/.env).
# Only the string "true" installs. `bash dev.sh rebuild` reads this file.
# Runtime secrets stay in dwpwebsite/.env — do not put API keys here.

INSTALL_CLAUDE_CLI=false
INSTALL_CODEX_CLI=false
INSTALL_CURSOR_CLI=false
INSTALL_PI_CLI=false
INSTALL_OPENCODE_CLI=false
INSTALL_CLINE_CLI=false
INSTALL_GROK_CLI=false

# Optional: path to a file (outside the repository) holding a GitHub token,
# passed to the build as the BuildKit secret github_token for the DeepWorkPlan
# Vim installer's Neovim checksum lookup (API rate limit). A path, never the token.
# DWP_GITHUB_TOKEN_FILE=
