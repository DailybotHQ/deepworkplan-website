# build output (no trailing slash: a pattern like `dist/` matches a directory
# only, so a symlinked build output — used to work around slow or broken
# filesystems — would not be ignored and can be staged by accident)
dist
# generated types (same reason)
.astro

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# pnpm
.pnpm-store/


# test coverage
coverage/

# Lighthouse CI local results
.lighthouseci/

# environment variables (examples stay tracked)
.env
.env.*
!.env.example

# OS-specific files
.DS_Store
Thumbs.db
desktop.ini

# jetbrains setting folder
.idea/

# VSCode (local editor settings)
.vscode/


# Temporary workspace (agent outputs, scratch files, ephemeral content)
tmp/*
!tmp/.gitkeep

english.png
spanish.png

# Deep Work Plan output (working state, not tracked) — except the addon
# registry, which is tracked so teammates and CI read the same decisions
# (DWP 7.0.0 spec/CONFIG.md; it never holds secrets)
.dwp/*
!.dwp/config.json

# Plan analysis output belongs in the plan's own folder
# (.dwp/plans/PLAN_x/analysis_results/), never here. A root-level
# analysis_results means an audit script fell back to its default --out;
# ignored so a missed flag can never become a commit. Safe to delete.
# No trailing slash, for the same reason as `dist` above.
/analysis_results

# Dailybot per-repo reporting opt-out (local kill-switch; profile.json IS tracked)
.dailybot/disabled

# Scheduler runtime lock (ephemeral, not tracked)
.agents/scheduled_tasks.lock

# Wrangler local cache (Cloudflare Pages dev)
.wrangler/

# Ecosystem hub: repositories/<name> are independent clones managed by
# scripts/repositories.sh (each commits, branches and opens PRs in its own
# repository). Only the navigation index and the manifest are tracked here.
repositories/*
!repositories/README.md
!repositories/manifest.json

# >>> dck:gitignore >>>
# devcontainer-kit: runtime env files hold secrets; backups from `dck init`.
docker/local/**/.env
docker/local/**/.env.*
!docker/local/**/.env.example
*.dck-bak-*
# <<< dck:gitignore <<<
