/*
  Cache-Control: public, max-age=0, must-revalidate

/
  Link: </.well-known/api-catalog>; rel="api-catalog", </openapi.json>; rel="service-desc", </.well-known/mcp.json>; rel="describedby"

/es/
  Link: </.well-known/api-catalog>; rel="api-catalog", </openapi.json>; rel="service-desc", </.well-known/mcp.json>; rel="describedby"

# OpenAPI 3.1 spec of the agent API (read-only, zero-auth)
/openapi.json
  Content-Type: application/json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300, must-revalidate

# Agent-readiness .well-known endpoints (RFC 9727, RFC 8414, RFC 9728, SEP-1649, agent-skills v0.2.0, ARD ai-catalog)
/.well-known/api-catalog
  Content-Type: application/linkset+json
  Cache-Control: public, max-age=300, must-revalidate

# ARD capability manifest (agenticresourcediscovery.org): the scanner requires
# application/json + Access-Control-Allow-Origin: * at the origin root.
/.well-known/ai-catalog.json
  Content-Type: application/json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300, must-revalidate

# MCP manifest (Streamable HTTP transport at /api/mcp)
/.well-known/mcp.json
  Content-Type: application/json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300, must-revalidate

# Static health marker for the agent API (the MCP endpoint sets its own headers
# as a Cloudflare Pages Function — _headers does not apply there)
/api/health.json
  Content-Type: application/json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300, must-revalidate

/.well-known/oauth-authorization-server
  Content-Type: application/json
  Cache-Control: public, max-age=300, must-revalidate

/.well-known/oauth-protected-resource
  Content-Type: application/json
  Cache-Control: public, max-age=300, must-revalidate

/.well-known/mcp/server-card.json
  Cache-Control: public, max-age=300, must-revalidate

/.well-known/agent-skills/index.json
  Cache-Control: public, max-age=300, must-revalidate

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=2592000

/icons/*
  Cache-Control: public, max-age=2592000

/favicon.ico
  Cache-Control: public, max-age=604800

/favicon.svg
  Cache-Control: public, max-age=604800

/site.webmanifest
  Cache-Control: public, max-age=86400, must-revalidate
