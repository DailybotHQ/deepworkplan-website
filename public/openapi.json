        "responses": {
          "200": {
            "description": "ARD catalog (JSON, CORS-enabled).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "examples": {
                  "entry": {
                    "value": {
                      "specVersion": "1.0",
                      "host": {
                        "displayName": "Deep Work Plan",
                        "identifier": "did:web:deepworkplan.com"
                      },
                      "entries": []
                    }
                  }
                }
              }
            }
          }
        }
      }
